{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=initiative-scoping.dev.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Auth": {
    "UseDevelopmentAuth": true,
    "Dev": {
      "UserId": "dev-user",
      "DisplayName": "Dev User",
      "Roles": [ "Administrator", "InitiativeOwner", "Contributor", "Viewer", "FinancePmo" ]
    }
  }
}
