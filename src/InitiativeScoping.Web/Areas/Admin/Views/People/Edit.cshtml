@model PersonEditModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Person" : "Edit Person";
}
<h2 class="h4">@ViewData["Title"]</h2>
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="DisplayName" class="form-label"></label>
        <input asp-for="DisplayName" class="form-control" />
        <span asp-validation-for="DisplayName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ExternalIds" class="form-label"></label>
        <input asp-for="ExternalIds" class="form-control" placeholder="e.g. PV-1042; jane.doe@example.com" />
        <div class="form-text">Separate multiple IDs with semicolons. Actuals rows are matched on any of them (case-insensitive).</div>
        <span asp-validation-for="ExternalIds" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ResourceTypeId" class="form-label"></label>
            <select asp-for="ResourceTypeId" asp-items="ViewBag.ResourceTypes" class="form-select"><option value="">Choose…</option></select>
            <span asp-validation-for="ResourceTypeId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="BusinessUnitId" class="form-label"></label>
            <select asp-for="BusinessUnitId" asp-items="ViewBag.BusinessUnits" class="form-select"><option value="">Choose…</option></select>
            <span asp-validation-for="BusinessUnitId" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="SeniorityId" class="form-label"></label>
            <select asp-for="SeniorityId" asp-items="ViewBag.Seniorities" class="form-select"></select>
            <span asp-validation-for="SeniorityId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ResourcingClassId" class="form-label"></label>
            <select asp-for="ResourcingClassId" asp-items="@((SelectList)ViewBag.ResourcingClasses)" class="form-select"></select>
            <span asp-validation-for="ResourcingClassId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3" id="vendor-wrap" hidden>
            <label asp-for="VendorId" class="form-label"></label>
            <select asp-for="VendorId" asp-items="ViewBag.Vendors" class="form-select" disabled><option value="">Unspecified</option></select>
            <span asp-validation-for="VendorId" class="text-danger"></span>
        </div>
    </div>
    <fieldset class="mb-3" data-filter-picker>
        <legend class="h6">Development pods</legend>
        @if (!isNew)
        {
            var total = Model.PodMembershipPercents.Values.Sum();
            var warning = PodMembershipWarning.For(Model.DisplayName, total);
            <p class="@(warning is null ? "small text-muted" : "alert alert-warning") text-break" role="status">@(warning ?? $"{total:0.##}% total membership across pods.")</p>
        }
        <p class="form-text">New memberships start at 100%. Retained memberships keep their percentage; edit percentages on the pod page.</p>
        <label for="pod-filter" class="form-label">Filter pods</label>
        <input id="pod-filter" type="search" class="form-control mb-2" data-filter-query aria-controls="person-pods" />
        <p class="small text-muted" data-filter-status role="status" aria-live="polite"></p>
        <span asp-validation-for="PodIds" class="text-danger"></span>
        <div id="person-pods">
        @foreach (var pod in Model.PodOptions)
        {
            <div class="mb-2 text-break" data-filter-name="@pod.Name">
                <label><input type="checkbox" name="PodIds" value="@pod.Id" checked="@Model.PodIds.Contains(pod.Id)" /> @pod.Name @(!pod.IsActive ? "(inactive)" : "")</label>
                <span class="small">— @Model.PodMembershipPercents.GetValueOrDefault(pod.Id, 100m).ToString("0.##")%</span>
                <a asp-controller="Pods" asp-action="Edit" asp-route-id="@pod.Id" class="small" aria-label="Edit membership percentages for @pod.Name">Edit %</a>
            </div>
        }
        </div>
    </fieldset>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Active (inactive people are not matched by new imports)</label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script src="~/js/filter-picker.js" asp-append-version="true"></script>
    <script>
        (function () {
            const cls = document.getElementById('ResourcingClassId'), wrap = document.getElementById('vendor-wrap'), vendor = document.getElementById('VendorId');
            const vendorClasses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<int>)ViewBag.VendorClassIds).Select(id => id.ToString())));
            function sync() { const v = vendorClasses.includes(cls.value); wrap.hidden = !v; vendor.disabled = !v; }
            cls.addEventListener('change', sync);
            sync();
        })();
    </script>
}
