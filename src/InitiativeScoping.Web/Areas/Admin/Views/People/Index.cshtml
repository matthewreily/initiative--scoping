@model PeopleIndexModel
@{
    ViewData["Title"] = "People";
    var search = Model.Search;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h4 mb-0">People roster</h2>
    <div class="d-flex flex-wrap gap-2">
        <form method="get" class="d-flex gap-2">
            <input name="search" value="@search" class="form-control form-control-sm" placeholder="Name or external ID" aria-label="Search people" />
            <button type="submit" class="btn btn-outline-secondary btn-sm">Search</button>
        </form>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Export">Export CSV</a>
        <a class="btn btn-primary btn-sm" asp-action="Create">New person</a>
    </div>
</div>
<p class="text-muted small">Imported actuals are matched to people by external ID and priced from the person's resource type, seniority, location, class and business unit.</p>
<div class="card mb-3">
    <div class="card-header py-2">Import CSV</div>
    <div class="card-body">
        <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
            <input type="file" name="File" accept=".csv,text/csv" class="form-control form-control-sm w-auto" aria-label="People CSV file" required />
            <button type="submit" class="btn btn-outline-primary btn-sm">Import</button>
            <a asp-action="Template" class="btn btn-link btn-sm">Download template</a>
        </form>
        <p class="text-muted small mt-2 mb-0">Columns: DisplayName, ExternalIds (';'-separated), ResourceType, BusinessUnit, Seniority (any name; new names are added to Admin → Seniority), Location, ResourcingClass (a name from Admin → Resourcing classes, e.g. Internal or Vendor; the legacy "InternalFte" is accepted), IsActive (optional), Vendor (optional; catalog vendor name for vendor-backed rows). Rows update an existing person matched by external ID, else by name; otherwise a new person is added. The whole file is rejected if any row is invalid.</p>
    </div>
</div>
<form asp-action="BulkDelete" method="post" data-bulk>
<table class="table table-sm align-middle people-table" data-sortable data-columns>
    <thead><tr><th data-nosort><input type="checkbox" class="form-check-input" data-bulk-all aria-label="Select all" /></th><th>Name</th><th class="d-none d-md-table-cell">External IDs</th><th>Role</th><th>Business unit</th><th class="d-none d-md-table-cell">Location</th><th>Class</th><th class="d-none d-md-table-cell">Actuals</th><th data-nosort></th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        var p = item.Person;
        <tr>
            <td><input type="checkbox" class="form-check-input" name="ids" value="@p.Id" data-bulk-item aria-label="Select row" /></td>
            <td data-sort="@p.DisplayName"><span class="status-dot @(p.IsActive ? "bg-success" : "bg-secondary")" title="@(p.IsActive ? "Active" : "Inactive")" aria-label="@(p.IsActive ? "Active" : "Inactive")"></span>@p.DisplayName</td>
            <td class="small text-muted d-none d-md-table-cell"><span class="d-inline-block text-truncate align-bottom" style="max-width: 10rem" title="@p.ExternalIds">@p.ExternalIds</span></td>
            <td data-sort="@p.ResourceType?.Name @p.Seniority!.SortOrder">@p.ResourceType?.Name<div class="small text-muted">@p.Seniority.Name</div></td>
            <td>@p.BusinessUnit?.Name</td>
            <td class="d-none d-md-table-cell">@p.Location</td>
            <td>@(p.ResourcingClass?.Name ?? "—")@if (p.ResourcingClass?.IsVendor == true && p.Vendor is not null) {<div class="small text-muted">@p.Vendor.Name</div>}</td>
            <td class="d-none d-md-table-cell">@item.EntryCount</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                @if (item.EntryCount == 0)
                {
                    <button type="submit" formaction="@Url.Action("Delete", new { id = p.Id })" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete @p.DisplayName?');">Delete</button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled title="Has actuals; deactivate instead">Delete</button>
                }
            </td>
        </tr>
    }
    @if (Model.Items.Count == 0)
    {
        <tr data-nosort><td colspan="9" class="text-muted">@(string.IsNullOrWhiteSpace(search) ? "No people yet." : "No people match your search.")</td></tr>
    }
    </tbody>
</table>
<partial name="_Pager" model="Model.Pager(Url)" />
<partial name="_BulkBar" model='new BulkBarOptions("people")' />
</form>
