@model IReadOnlyList<ResourceTypeListItem>
@{
    ViewData["Title"] = "Resource Types";
}
<h1 class="h3">Administration</h1>
<partial name="_AdminNav" />
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h5 mb-0">Resource Types</h2>
    <a class="btn btn-primary btn-sm" asp-action="Create">New resource type</a>
</div>
<p class="text-muted small">Seniority is chosen per initiative allocation, not per resource type.</p>
<form asp-action="BulkDelete" method="post" data-bulk>
<div class="table-responsive">
<table class="table table-sm align-middle" data-sortable>
    <thead><tr><th data-nosort><input type="checkbox" class="form-check-input" data-bulk-all aria-label="Select all" /></th><th>Name</th><th>Discipline</th><th>Status</th><th>References</th><th data-nosort></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td><input type="checkbox" class="form-check-input" name="ids" value="@item.Type.Id" data-bulk-item aria-label="Select row" /></td>
            <td>@item.Type.Name</td>
            <td>@item.Type.Discipline!.Name</td>
            <td>@(item.Type.IsActive ? Html.Raw("<span class='badge bg-success'>Active</span>") : Html.Raw("<span class='badge bg-secondary'>Inactive</span>"))</td>
            <td>@item.ReferenceCount</td>
            <td class="text-end">
                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Type.Id">Edit</a>
                @if (item.ReferenceCount == 0)
                {
                    <button type="submit" formaction="@Url.Action("Delete", new { id = item.Type.Id })" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete @item.Type.Name?');">Delete</button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled title="Referenced; deactivate instead">Delete</button>
                }
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr data-nosort><td colspan="6" class="text-muted">No resource types yet.</td></tr>
    }
    </tbody>
</table>
</div>
<partial name="_BulkBar" model='new BulkBarOptions("resource types")' />
</form>
