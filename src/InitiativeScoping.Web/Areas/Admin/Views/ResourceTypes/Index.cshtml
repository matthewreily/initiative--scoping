@model IReadOnlyList<ResourceTypeListItem>
@{
    ViewData["Title"] = "Resource Types";
}
<h1 class="h3">Administration</h1>
<partial name="_AdminNav" />
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h5 mb-0">Resource Types</h2>
    <a class="btn btn-primary btn-sm" asp-action="Create">New resource type</a>
</div>
<p class="text-muted small">Seniority is chosen per initiative allocation, not per resource type.</p>
<div class="table-responsive">
<table class="table table-sm align-middle">
    <thead><tr><th>Name</th><th>Discipline</th><th>Status</th><th>References</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Type.Name</td>
            <td>@item.Type.Discipline</td>
            <td>@(item.Type.IsActive ? Html.Raw("<span class='badge bg-success'>Active</span>") : Html.Raw("<span class='badge bg-secondary'>Inactive</span>"))</td>
            <td>@item.ReferenceCount</td>
            <td class="text-end">
                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Type.Id">Edit</a>
                @if (item.ReferenceCount == 0)
                {
                    <form asp-action="Delete" asp-route-id="@item.Type.Id" method="post" class="d-inline" onsubmit="return confirm('Delete @item.Type.Name?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled title="Referenced; deactivate instead">Delete</button>
                }
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="5" class="text-muted">No resource types yet.</td></tr>
    }
    </tbody>
</table>
</div>
