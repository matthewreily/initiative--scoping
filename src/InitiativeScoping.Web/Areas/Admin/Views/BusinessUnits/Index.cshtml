@model IReadOnlyList<BusinessUnitListItem>
@{
    ViewData["Title"] = "Business Units";
}
<h1 class="h3">Administration</h1>
<partial name="_AdminNav" />
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">Business Units</h2>
    <a class="btn btn-primary btn-sm" asp-action="Create">New business unit</a>
</div>
<table class="table table-sm align-middle">
    <thead><tr><th>Name</th><th>Status</th><th>References</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Unit.Name</td>
            <td>@(item.Unit.IsActive ? Html.Raw("<span class='badge bg-success'>Active</span>") : Html.Raw("<span class='badge bg-secondary'>Inactive</span>"))</td>
            <td>@item.ReferenceCount</td>
            <td class="text-end">
                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Unit.Id">Edit</a>
                @if (item.ReferenceCount == 0)
                {
                    <form asp-action="Delete" asp-route-id="@item.Unit.Id" method="post" class="d-inline" onsubmit="return confirm('Delete @item.Unit.Name?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled title="Referenced; deactivate instead">Delete</button>
                }
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="4" class="text-muted">No business units yet.</td></tr>
    }
    </tbody>
</table>
