@model IReadOnlyList<VendorListItem>
@{
    ViewData["Title"] = "Vendors";
}
<h1 class="h3">Administration</h1>
<partial name="_AdminNav" />
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h5 mb-0">Vendors</h2>
    <a class="btn btn-primary btn-sm" asp-action="Create">New vendor</a>
</div>
<p class="text-muted small">Vendors identify who supplies vendor-classed resources. Rate card rows, allocations and people with class = Vendor reference one, so different vendors can be priced separately within the same business unit.</p>
<form asp-action="BulkDelete" method="post" data-bulk>
<div class="table-responsive">
<table class="table table-sm align-middle" data-sortable>
    <thead><tr><th data-nosort><input type="checkbox" class="form-check-input" data-bulk-all aria-label="Select all" /></th><th>Name</th><th>Status</th><th>Rate card rows</th><th>Allocations</th><th>People</th><th data-nosort></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        var referenced = item.RateCardEntries + item.Allocations + item.People > 0;
        <tr>
            <td><input type="checkbox" class="form-check-input" name="ids" value="@item.Vendor.Id" data-bulk-item aria-label="Select row" /></td>
            <td>@item.Vendor.Name</td>
            <td>@(item.Vendor.IsActive ? Html.Raw("<span class='badge bg-success'>Active</span>") : Html.Raw("<span class='badge bg-secondary'>Inactive</span>"))</td>
            <td>@item.RateCardEntries</td>
            <td>@item.Allocations</td>
            <td>@item.People</td>
            <td class="text-end">
                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Vendor.Id">Edit</a>
                @if (!referenced)
                {
                    <button type="submit" formaction="@Url.Action("Delete", new { id = item.Vendor.Id })" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete @item.Vendor.Name?');">Delete</button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled title="Referenced; deactivate instead">Delete</button>
                }
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr data-nosort><td colspan="7" class="text-muted">No vendors yet.</td></tr>
    }
    </tbody>
</table>
</div>
<partial name="_BulkBar" model='new BulkBarOptions("vendors")' />
</form>
