@model WorkCalendarViewModel
@{
    ViewData["Title"] = "Work Calendar";
}
<h1 class="h3">Administration</h1>
<partial name="_AdminNav" />
<h2 class="h5">Work Calendar</h2>
<p class="text-muted">Fixed-duration initiatives compute allocation hours as quantity × allocation % × working days (Mon–Fri excluding holidays) × hours per day.</p>

<form asp-action="Settings" method="post" class="row g-2 align-items-end mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-auto">
        <label asp-for="HoursPerDay" class="form-label"></label>
        <input asp-for="HoursPerDay" class="form-control" type="number" step="0.25" min="0.5" max="24" style="max-width: 10rem" />
        <span asp-validation-for="HoursPerDay" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="h6 mb-0">Holidays</h3>
    <a class="btn btn-primary btn-sm" asp-action="CreateHoliday">New holiday</a>
</div>
<div class="table-responsive">
<table class="table table-sm align-middle">
    <thead><tr><th>Date</th><th>Name</th><th></th></tr></thead>
    <tbody>
    @foreach (var h in Model.Holidays)
    {
        <tr>
            <td>@h.Date.ToString("yyyy-MM-dd") <span class="text-muted">(@h.Date.DayOfWeek)</span></td>
            <td>@h.Name</td>
            <td class="text-end">
                <a class="btn btn-outline-secondary btn-sm" asp-action="EditHoliday" asp-route-id="@h.Id">Edit</a>
                <form asp-action="DeleteHoliday" asp-route-id="@h.Id" method="post" class="d-inline" onsubmit="return confirm('Delete @h.Name?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Holidays.Count == 0)
    {
        <tr><td colspan="3" class="text-muted">No holidays configured; only weekends are excluded.</td></tr>
    }
    </tbody>
</table>
</div>
@section Scripts { <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" /> }
