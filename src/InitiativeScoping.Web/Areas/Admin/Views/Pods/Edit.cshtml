@model PodEditModel
@{ ViewData["Title"] = "Edit Development Pods"; }
<h2 class="h4">@ViewData["Title"]</h2>
@foreach (var warning in Model.MembershipWarnings)
{
    <p class="alert alert-warning" role="status">@warning</p>
}
<form method="post" class="col-12 col-lg-8">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
    <div class="mb-3"><label asp-for="BusinessUnitId" class="form-label">Business unit</label><select asp-for="BusinessUnitId" asp-items="@(new SelectList(Model.BusinessUnits, "Id", "Name"))" class="form-select"><option value="">Choose…</option></select></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <fieldset class="mb-3" data-filter-picker><legend class="h6">Active roster members</legend>
    <label for="member-filter" class="form-label">Filter people by name</label>
    <input id="member-filter" type="search" class="form-control mb-2" data-filter-query aria-controls="pod-members" />
    <p class="small text-muted" data-filter-status role="status" aria-live="polite"></p>
    <div id="pod-members">
    @foreach (var person in Model.People)
    {
        <div class="row g-2 mx-0 align-items-center mb-2 text-break" data-filter-name="@person.DisplayName">
            <div class="col-8"><label><input type="checkbox" name="PersonIds" value="@person.Id" checked="@Model.PersonIds.Contains(person.Id)" /> @person.DisplayName</label></div>
            <div class="col-4"><label class="small" for="membership-@person.Id">Membership %</label><input id="membership-@person.Id" name="MembershipPercents[@person.Id]" value="@Model.MembershipPercents.GetValueOrDefault(person.Id, 100m)" type="number" min="1" max="100" step="0.01" class="form-control form-control-sm" aria-label="Membership % for @person.DisplayName" /></div>
        </div>
    }
    </div>
    </fieldset>
    <fieldset class="mb-3"><legend class="h6">Applications / Platforms</legend>
    @foreach (var app in Model.Applications)
    {
        <label class="d-block"><input type="checkbox" name="ApplicationIds" value="@app.Id" checked="@Model.ApplicationIds.Contains(app.Id)" /> @app.Name</label>
    }
    </fieldset>
    <button type="submit" class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts {
    <script src="~/js/filter-picker.js" asp-append-version="true"></script>
}
