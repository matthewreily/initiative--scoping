@model List<Pod>
@{ ViewData["Title"] = "Development Pods"; }
<h2 class="h4">Development Pods</h2>
<p><a asp-action="Create" class="btn btn-primary">Create</a></p>
<div class="row g-3">
@foreach (var item in Model)
{
    <div class="col-12 col-md-6 col-xl-4"><div class="card h-100"><div class="card-body">
        <h3 class="h5 text-break">@item.Name</h3>
        <p>@(item.IsActive ? "Active" : "Inactive") · @item.BusinessUnit?.Name · @item.Members.Count members · @item.Applications.Count apps</p>
        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-outline-danger btn-sm" type="submit">Delete</button></form>
    </div></div></div>
}
</div>
