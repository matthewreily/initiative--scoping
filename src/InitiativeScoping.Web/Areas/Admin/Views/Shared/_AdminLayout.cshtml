@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isIndex = string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    string Cls(string c) => c == current ? "nav-link active" : "nav-link";
    var groups = new (string Heading, (string Controller, string Label)[] Items)[]
    {
        ("Catalogs", new[]
        {
            ("BusinessUnits", "Business Units"),
            ("Disciplines", "Disciplines"),
            ("ResourceTypes", "Resource Types"),
            ("Seniorities", "Seniority"),
            ("ResourcingClasses", "Resourcing Classes"),
            ("Vendors", "Vendors"),
            ("People", "People")
        }),
        ("Pricing", new[]
        {
            ("RateCards", "Rate Cards"),
            ("CostCatalog", "Cost Catalog")
        }),
        ("Planning", new[]
        {
            ("Sizing", "Sizing"),
            ("WorkCalendar", "Work Calendar")
        }),
        ("Access", new[]
        {
            ("Users", "Users")
        })
    };
}
<div class="row g-4">
    <aside class="col-lg-2 admin-sidebar">
        <h1 class="h6 text-uppercase text-muted mb-3">Administration</h1>
        <nav class="admin-nav" aria-label="Administration">
            @foreach (var group in groups)
            {
                <div class="admin-nav-group">
                    <div class="admin-nav-heading">@group.Heading</div>
                    <ul class="nav nav-pills flex-column">
                        @foreach (var (controller, label) in group.Items)
                        {
                            <li class="nav-item"><a class="@Cls(controller)" asp-area="Admin" asp-controller="@controller" asp-action="Index">@label</a></li>
                        }
                    </ul>
                </div>
            }
        </nav>
    </aside>
    <div class="col-lg-10 min-w-0">
        @{
            var crumb = groups.SelectMany(g => g.Items).FirstOrDefault(i => i.Controller == current);
        }
        @if (crumb.Controller is not null)
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="BusinessUnits" asp-action="Index">Admin</a></li>
                    @if (isIndex)
                    {
                        <li class="breadcrumb-item active" aria-current="page">@crumb.Label</li>
                    }
                    else
                    {
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="@crumb.Controller" asp-action="Index">@crumb.Label</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    }
                </ol>
            </nav>
        }
        @RenderBody()
    </div>
</div>
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
