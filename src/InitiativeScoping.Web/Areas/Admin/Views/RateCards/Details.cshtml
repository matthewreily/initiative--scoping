@model RateCardDetailsModel
@{
    var card = Model.Card;
    ViewData["Title"] = card.Name;
}
<h1 class="h3">Administration</h1>
<partial name="_AdminNav" />

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">@card.Name <partial name="_StatusBadge" model="card.Status" /></h2>
        <div class="text-muted small">Effective from @card.EffectiveStart.ToString("yyyy-MM-dd") &middot; @card.Entries.Count entr@(card.Entries.Count == 1 ? "y" : "ies") shown</div>
    </div>
    <div class="btn-group">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@card.Id">Edit card</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Export" asp-route-id="@card.Id">Export CSV</a>
        @if (card.Status == RateCardStatus.Draft)
        {
            <form asp-action="Publish" asp-route-id="@card.Id" method="post" class="d-inline" onsubmit="return confirm('Publish @card.Name? It becomes eligible for forecasts.');">
                <button type="submit" class="btn btn-success btn-sm">Publish</button>
            </form>
        }
        else if (card.Status == RateCardStatus.Published)
        {
            <form asp-action="Retire" asp-route-id="@card.Id" method="post" class="d-inline" onsubmit="return confirm('Retire @card.Name? New forecasts will no longer use it.');">
                <button type="submit" class="btn btn-warning btn-sm">Retire</button>
            </form>
        }
    </div>
</div>

@if (card.Status == RateCardStatus.Published)
{
    <div class="alert alert-info py-2 small">This card is published. Rate changes affect future forecast calculations only; committed baselines keep their snapshotted rates.</div>
}
else if (card.Status == RateCardStatus.Retired)
{
    <div class="alert alert-secondary py-2 small">This card is retired and read-only.</div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <form method="get" class="row g-2 align-items-end mb-2">
            <div class="col-auto">
                <label class="form-label small mb-0">Filter by resource type</label>
                <select name="resourceType" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All</option>
                    @foreach (var item in Model.ResourceTypes)
                    {
                        <option value="@item.Text" selected="@(item.Text == Model.FilterResourceType)">@item.Text</option>
                    }
                </select>
            </div>
        </form>
        <form asp-action="BulkUpdateEntries" asp-route-id="@card.Id" method="post" data-bulk id="entries-form">
        <div class="table-responsive">
        <table class="table table-sm align-middle" data-sortable>
            <thead>
                <tr>
                    @if (Model.IsEditable)
                    {
                        <th data-nosort><input type="checkbox" class="form-check-input" data-bulk-all aria-label="Select all entries" /></th>
                    }
                    <th>Resource type</th><th>Business unit</th><th>Seniority</th><th>Location</th><th>Class</th><th>Vendor</th><th class="text-end">Hourly rate</th><th data-nosort></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in card.Entries)
            {
                <tr>
                    @if (Model.IsEditable)
                    {
                        <td><input type="checkbox" class="form-check-input" name="entryIds" value="@e.Id" data-bulk-item aria-label="Select entry" /></td>
                    }
                    <td>@e.ResourceType!.Name</td>
                    <td>@e.BusinessUnit!.Name</td>
                    <td>@e.Seniority</td>
                    <td>@e.Location</td>
                    <td>@(e.ResourcingClass == ResourcingClass.InternalFte ? "Internal" : "Vendor")</td>
                    <td>@(e.ResourcingClass == ResourcingClass.Vendor ? e.Vendor?.Name ?? "(any vendor)" : "—")</td>
                    <td class="text-end" data-sort="@e.HourlyRate">
                        @if (Model.IsEditable)
                        {
                            <div class="d-inline-flex gap-1 justify-content-end">
                                <input type="number" name="rates[@e.Id]" value="@e.HourlyRate" step="0.01" min="0" class="form-control form-control-sm text-end" style="width: 7rem" aria-label="Hourly rate" />
                                <button type="submit" formaction="@Url.Action("UpdateEntry", new { id = card.Id })" name="entryId" value="@e.Id" class="btn btn-outline-primary btn-sm">Save</button>
                            </div>
                        }
                        else
                        {
                            @e.HourlyRate.ToString("0.00")
                        }
                    </td>
                    <td class="text-end">
                        @if (Model.IsEditable)
                        {
                            <button type="submit" formaction="@Url.Action("DeleteEntry", new { id = card.Id })" name="entryId" value="@e.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Remove this entry?');" aria-label="Remove entry">&times;</button>
                        }
                    </td>
                </tr>
            }
            @if (card.Entries.Count == 0)
            {
                <tr data-nosort><td colspan="9" class="text-muted">No entries. Add one below or import a CSV.</td></tr>
            }
            </tbody>
        </table>
        </div>
        @if (Model.IsEditable && card.Entries.Count > 0)
        {
            <div class="bulk-bar d-flex flex-wrap align-items-center gap-2 py-2" data-bulk-bar>
                <span class="small text-muted me-auto" data-bulk-count>None selected</span>
                <button type="submit" class="btn btn-outline-primary btn-sm">Save selected</button>
                <div class="input-group input-group-sm" style="width: 12rem">
                    <input type="number" name="adjustPercent" step="0.1" class="form-control" placeholder="e.g. 5 or -3" aria-label="Adjust selected rates by percent" />
                    <button type="submit" formaction="@Url.Action("BulkAdjustEntries", new { id = card.Id })" class="btn btn-outline-secondary">Adjust %</button>
                </div>
                <button type="submit" formaction="@Url.Action("BulkDeleteEntries", new { id = card.Id })" class="btn btn-outline-danger btn-sm" data-confirm="Remove {n} selected entries?">Delete selected</button>
            </div>
        }
        </form>
    </div>

    @if (Model.IsEditable)
    {
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header py-2">Add entry</div>
                <div class="card-body">
                    <form asp-action="AddEntry" asp-route-id="@card.Id" method="post">
                        <div class="mb-2">
                            <label asp-for="NewEntry.ResourceTypeId" class="form-label small"></label>
                            <select asp-for="NewEntry.ResourceTypeId" asp-items="Model.ResourceTypes" class="form-select form-select-sm" name="ResourceTypeId"></select>
                        </div>
                        <div class="mb-2">
                            <label asp-for="NewEntry.BusinessUnitId" class="form-label small"></label>
                            <select asp-for="NewEntry.BusinessUnitId" asp-items="Model.BusinessUnits" class="form-select form-select-sm" name="BusinessUnitId"></select>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <label asp-for="NewEntry.Seniority" class="form-label small"></label>
                                <select asp-for="NewEntry.Seniority" asp-items="Html.GetEnumSelectList<Seniority>()" class="form-select form-select-sm" name="Seniority"></select>
                            </div>
                            <div class="col">
                                <label asp-for="NewEntry.ResourcingClass" class="form-label small"></label>
                                <select asp-for="NewEntry.ResourcingClass" class="form-select form-select-sm" name="ResourcingClass" id="entry-class">
                                    <option value="@ResourcingClass.InternalFte">Internal</option>
                                    <option value="@ResourcingClass.Vendor">Vendor</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-2" id="entry-vendor-wrap" hidden>
                            <label asp-for="NewEntry.VendorId" class="form-label small"></label>
                            <select asp-for="NewEntry.VendorId" asp-items="Model.Vendors" class="form-select form-select-sm" name="VendorId" disabled>
                                <option value="">Any vendor (generic rate)</option>
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col">
                                <label asp-for="NewEntry.Location" class="form-label small"></label>
                                <input asp-for="NewEntry.Location" class="form-control form-control-sm" name="Location" />
                            </div>
                            <div class="col">
                                <label asp-for="NewEntry.HourlyRate" class="form-label small"></label>
                                <input asp-for="NewEntry.HourlyRate" class="form-control form-control-sm" name="HourlyRate" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Add entry</button>
                    </form>
                    <script>
                        (function () {
                            const cls = document.getElementById('entry-class'), wrap = document.getElementById('entry-vendor-wrap'), vendor = wrap.querySelector('select');
                            function sync() { const v = cls.value === '@ResourcingClass.Vendor'; wrap.hidden = !v; vendor.disabled = !v; }
                            cls.addEventListener('change', sync);
                            sync();
                        })();
                    </script>
                </div>
            </div>

            <div class="card">
                <div class="card-header py-2">Import CSV</div>
                <div class="card-body">
                    <form asp-action="Import" asp-route-id="@card.Id" method="post" enctype="multipart/form-data">
                        <div class="mb-2">
                            <input type="file" name="File" accept=".csv,text/csv" class="form-control form-control-sm" required />
                        </div>
                        <div class="form-check mb-2">
                            <input type="checkbox" name="Replace" value="true" class="form-check-input" id="replace" />
                            <label class="form-check-label small" for="replace">Replace existing entries (otherwise merge: add new, update changed rates)</label>
                        </div>
                        <button type="submit" class="btn btn-outline-primary btn-sm">Import</button>
                        <a asp-action="Template" class="btn btn-link btn-sm">Download template</a>
                    </form>
                    <p class="text-muted small mt-2 mb-0">Columns: ResourceType, BusinessUnit, Seniority, Location, ResourcingClass (Internal/Vendor), HourlyRate, Vendor (optional; names a catalog vendor for Vendor rows, blank = generic vendor rate). The whole file is rejected if any row is invalid.</p>
                </div>
            </div>
        </div>
    }
</div>
