@model AllocationTemplateEditModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Allocation Template" : "Edit Allocation Template";
    var resourceTypes = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.ResourceTypes;
    var seniorities = Html.GetEnumSelectList<Seniority>();
}
<h1 class="h3">Administration</h1>
<partial name="_AdminNav" />
<h2 class="h5">@ViewData["Title"]</h2>
<form asp-action="@(isNew ? "CreateTemplate" : "EditTemplate")" asp-route-id="@(isNew ? null : Model.Id)" method="post" class="col-lg-9">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label asp-for="Method" class="form-label"></label>
            <select asp-for="Method" class="form-select">
                <option value="@SizingMethod.TShirt">T-shirt</option>
                <option value="@SizingMethod.StoryPoints">Story points</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="SizeKey" class="form-label"></label>
            <input asp-for="SizeKey" class="form-control" placeholder="e.g. L" />
            <span asp-validation-for="SizeKey" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Large feature - standard squad" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <h3 class="h6">Lines</h3>
    <table class="table table-sm" id="lines">
        <thead><tr><th>Phase</th><th>Resource type</th><th>Seniority</th><th style="width: 8rem">%</th><th></th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            <tr>
                <td><input asp-for="Lines[i].PhaseName" class="form-control form-control-sm" placeholder="e.g. Build" /></td>
                <td><select asp-for="Lines[i].ResourceTypeId" asp-items="resourceTypes" class="form-select form-select-sm"></select></td>
                <td><select asp-for="Lines[i].Seniority" asp-items="seniorities" class="form-select form-select-sm"></select></td>
                <td><input asp-for="Lines[i].Percent" class="form-control form-control-sm text-end" type="number" step="0.01" min="0" max="100" /></td>
                <td><button type="button" class="btn btn-outline-danger btn-sm remove-line">&times;</button></td>
            </tr>
        }
        </tbody>
    </table>
    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="add-line">Add line</button>
    <div class="small text-muted mb-3">Total: <span id="total">0</span>%</div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

<template id="line-template">
    <tr>
        <td><input name="Lines[__i__].PhaseName" class="form-control form-control-sm" placeholder="e.g. Build" /></td>
        <td><select name="Lines[__i__].ResourceTypeId" class="form-select form-select-sm">
            @foreach (var rt in resourceTypes) { <option value="@rt.Value">@rt.Text</option> }
        </select></td>
        <td><select name="Lines[__i__].Seniority" class="form-select form-select-sm">
            @foreach (var s in seniorities) { <option value="@s.Value">@s.Text</option> }
        </select></td>
        <td><input name="Lines[__i__].Percent" class="form-control form-control-sm text-end" type="number" step="0.01" min="0" max="100" value="0" /></td>
        <td><button type="button" class="btn btn-outline-danger btn-sm remove-line">&times;</button></td>
    </tr>
</template>

@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        (function () {
            const tbody = document.querySelector('#lines tbody');
            const total = document.getElementById('total');
            function reindex() {
                [...tbody.rows].forEach((row, i) => {
                    row.querySelectorAll('[name]').forEach(el => {
                        el.name = el.name.replace(/Lines\[\d+|Lines\[__i__/, 'Lines[' + i);
                    });
                });
            }
            function recalc() {
                let sum = 0;
                tbody.querySelectorAll('input[name$=".Percent"]').forEach(el => sum += parseFloat(el.value) || 0);
                total.textContent = sum.toFixed(2).replace(/\.?0+$/, '');
                total.className = Math.abs(sum - 100) < 0.01 ? 'text-success' : 'text-danger';
            }
            document.getElementById('add-line').addEventListener('click', () => {
                const html = document.getElementById('line-template').innerHTML.replaceAll('__i__', tbody.rows.length);
                tbody.insertAdjacentHTML('beforeend', html);
                reindex();
                recalc();
            });
            tbody.addEventListener('click', e => {
                if (e.target.classList.contains('remove-line')) {
                    e.target.closest('tr').remove();
                    reindex();
                    recalc();
                }
            });
            tbody.addEventListener('input', recalc);
            recalc();
        })();
    </script>
}
