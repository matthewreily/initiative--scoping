@model ScenarioCompareModel
@{
    var p = Model.Parent;
    ViewData["Title"] = $"{p.Name} – Scenarios";
    var cols = Model.Comparison.Columns;
}
<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-controller="Initiatives" asp-action="Index">Initiatives</a></li>
    <li class="breadcrumb-item"><a asp-controller="Initiatives" asp-action="Details" asp-route-id="@p.Id">@p.Name</a></li>
    <li class="breadcrumb-item active">Scenarios</li>
</ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@p.Name <partial name="~/Views/Initiatives/_StatusBadge.cshtml" model="p.Status" /> <small class="text-muted fs-6">What-if scenarios</small></h1>
        <div class="text-muted small">
            Each scenario is a private copy of the live plan. Change staffing, dates, vendors or sizing on the scenario, compare here, then promote the winner to replace the live plan.
            @if (!Model.CanPromote && cols.Count > 1)
            {
                <span class="d-block mt-1">Promotion is available to owners while the live plan is in Draft or during an approved re-baseline.</span>
            }
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-start">
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="scenarios-export-menu">Export</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Scenarios" asp-action="Export" asp-route-id="@p.Id" asp-route-format="xlsx">Excel (.xlsx)</a></li>
                <li><a class="dropdown-item" asp-controller="Scenarios" asp-action="Export" asp-route-id="@p.Id" asp-route-format="csv">CSV</a></li>
            </ul>
        </div>
        <a class="btn btn-outline-secondary btn-sm text-nowrap" asp-controller="Scenarios" asp-action="Print" asp-route-id="@p.Id" id="scenarios-print-link">Print / PDF</a>
        @if (Model.CanEdit)
        {
            <form asp-controller="Scenarios" asp-action="Create" asp-route-id="@p.Id" method="post" class="d-flex gap-2 inline-form">
                <input asp-for="NewScenario.Name" name="Name" class="form-control form-control-sm" style="width: 18rem" aria-label="Scenario name" required maxlength="300" />
                <button type="submit" class="btn btn-primary btn-sm text-nowrap">New scenario from live plan</button>
            </form>
        }
    </div>
</div>

@if (cols.Count == 1)
{
    <div class="alert alert-secondary">
        No scenarios yet. Create one to explore an alternative plan without changing <strong>@p.Name</strong>; the live plan is shown below for reference.
    </div>
}

<partial name="_CompareTable" model="Model" />
