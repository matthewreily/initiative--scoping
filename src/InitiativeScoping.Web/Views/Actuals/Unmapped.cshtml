@model EntriesModel
@{
    ViewData["Title"] = "Unmapped actuals";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Actuals imports</a></li><li class="breadcrumb-item active">Unmapped</li></ol></nav>
<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h3 mb-0">Unmapped actuals</h1>
    <form asp-action="ApplyMappings" method="post">
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        <button type="submit" class="btn btn-outline-primary btn-sm" title="Re-run project mappings and roster matching for every unmapped entry">Re-apply mappings &amp; roster</button>
    </form>
</div>
<partial name="~/Views/Initiatives/_Alerts.cshtml" />
<p class="text-muted small">Entries whose project has no initiative mapping or whose person is not on the roster. Assign them here, or add the mapping/person and re-apply.</p>
<partial name="_Entries" model="Model" />
@if (Model.PageCount > 1)
{
    <nav><ul class="pagination pagination-sm">
        @for (var p = 1; p <= Model.PageCount; p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="Unmapped" asp-route-page="@p">@p</a></li>
        }
    </ul></nav>
}
