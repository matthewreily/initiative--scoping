@model InitiativeActualsModel
@{
    var i = Model.Initiative;
    var v = Model.Variance;
    ViewData["Title"] = $"{i.Name} – Actuals";
    string Signed(decimal d, string fmt) => (d >= 0 ? "+" : "") + d.ToString(fmt);
    string VarClass(decimal d) => d > 0 ? "text-danger" : d < 0 ? "text-success" : "";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Initiatives" asp-action="Index">Initiatives</a></li><li class="breadcrumb-item"><a asp-controller="Initiatives" asp-action="Details" asp-route-id="@i.Id">@i.Name</a></li><li class="breadcrumb-item active">Actuals</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
    <h1 class="h3">Actuals vs. baseline <partial name="~/Views/Initiatives/_StatusBadge.cshtml" model="i.Status" /></h1>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="Lifecycle" asp-action="Baselines" asp-route-id="@i.Id">Baselines</a>
</div>
<partial name="~/Views/Initiatives/_Alerts.cshtml" />

@if (v.Baseline is null)
{
    <div class="alert alert-secondary py-2">No baseline yet &mdash; variance is shown against zero until the initiative is activated.</div>
}
@if (v.ExceedsThreshold)
{
    <div class="alert alert-danger py-2"><strong>Over threshold:</strong> cost variance @v.CostVariancePct% exceeds the @v.ThresholdPct% threshold.</div>
}
@if (v.UnpricedEntries > 0)
{
    <div class="alert alert-warning py-2">@v.UnpricedEntries mapped entr@(v.UnpricedEntries == 1 ? "y has" : "ies have") no matching published rate and count as $0.</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Baseline v@(v.Baseline?.Version)</div><div class="fs-4">@v.BaselineCost.ToString("C0")</div><div class="small text-muted">@v.BaselineHours.ToString("N1") h</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Actual to date</div><div class="fs-4">@v.ActualCost.ToString("C0")</div><div class="small text-muted">@v.ActualHours.ToString("N1") h</div></div></div></div>
    <div class="col-md-3"><div class="card @(v.ExceedsThreshold ? "border-danger" : "")"><div class="card-body"><div class="text-muted small">Cost variance</div><div class="fs-4 @VarClass(v.CostVariance)">@Signed(v.CostVariance, "C0")</div><div class="small text-muted">@(v.CostVariancePct is null ? "n/a" : Signed(v.CostVariancePct.Value, "0.0") + "%") @(v.ThresholdPct is null ? "" : $"· threshold {v.ThresholdPct}%")</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Hours variance</div><div class="fs-4 @VarClass(v.HoursVariance)">@Signed(v.HoursVariance, "N1") h</div><div class="small text-muted">Sourced @v.SourcedHours.ToString("N1") h · adjustments @Signed(v.AdjustmentHours, "N1") h</div></div></div></div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Estimate to complete (ETC)</div><div class="fs-4">@v.EtcCost.ToString("C0")</div><div class="small text-muted">@v.EtcHours.ToString("N1") h · baseline for work after @v.AsOf.ToString("yyyy-MM-dd")</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Estimate at completion (EAC)</div><div class="fs-4">@v.EacCost.ToString("C0")</div><div class="small text-muted">@v.EacHours.ToString("N1") h · actual + ETC</div></div></div></div>
    <div class="col-md-3"><div class="card @(v.EacExceedsThreshold ? "border-danger" : "")"><div class="card-body"><div class="text-muted small">Projected variance (EAC − baseline)</div><div class="fs-4 @VarClass(v.EacCostVariance)">@Signed(v.EacCostVariance, "C0")</div><div class="small text-muted">@(v.EacCostVariancePct is null ? "n/a" : Signed(v.EacCostVariancePct.Value, "0.0") + "%")</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body small text-muted">ETC is schedule-based: future phases count in full, the in-progress phase pro-rata by remaining days, finished phases zero. Spending ahead of plan raises EAC one-for-one.</div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h5">By phase <span class="text-muted small fw-normal">(actuals assigned by work date)</span></h2>
        <div class="table-responsive">
        <table class="table table-sm">
            <thead><tr><th>Phase</th><th class="text-end">Baseline h</th><th class="text-end">Actual h</th><th class="text-end">Baseline $</th><th class="text-end">Actual $</th><th class="text-end">Variance</th><th class="text-end">EAC $</th><th class="text-end">Projected</th></tr></thead>
            <tbody>
            @foreach (var r in v.ByPhase)
            {
                <tr>
                    <td>@r.Label</td>
                    <td class="text-end">@r.BaselineHours.ToString("N1")</td>
                    <td class="text-end">@r.ActualHours.ToString("N1")</td>
                    <td class="text-end">@r.BaselineCost.ToString("C0")</td>
                    <td class="text-end">@r.ActualCost.ToString("C0")</td>
                    <td class="text-end @VarClass(r.CostVariance)">@Signed(r.CostVariance, "C0") @(r.CostVariancePct is null ? "" : $"({Signed(r.CostVariancePct.Value, "0.0")}%)")</td>
                    <td class="text-end">@r.EacCost.ToString("C0")</td>
                    <td class="text-end @VarClass(r.EacCostVariance)">@Signed(r.EacCostVariance, "C0") @(r.EacCostVariancePct is null ? "" : $"({Signed(r.EacCostVariancePct.Value, "0.0")}%)")</td>
                </tr>
            }
            @if (v.ByPhase.Count == 0) { <tr><td colspan="8" class="text-muted">Nothing yet.</td></tr> }
            </tbody>
        </table>
        </div>
    </div>
    <div class="col-lg-6">
        <h2 class="h5">By resource type <span class="text-muted small fw-normal">(from the person roster)</span></h2>
        <div class="table-responsive">
        <table class="table table-sm">
            <thead><tr><th>Resource type</th><th class="text-end">Baseline h</th><th class="text-end">Actual h</th><th class="text-end">Baseline $</th><th class="text-end">Actual $</th><th class="text-end">Variance</th><th class="text-end">EAC $</th><th class="text-end">Projected</th></tr></thead>
            <tbody>
            @foreach (var r in v.ByResourceType)
            {
                <tr>
                    <td>@r.Label</td>
                    <td class="text-end">@r.BaselineHours.ToString("N1")</td>
                    <td class="text-end">@r.ActualHours.ToString("N1")</td>
                    <td class="text-end">@r.BaselineCost.ToString("C0")</td>
                    <td class="text-end">@r.ActualCost.ToString("C0")</td>
                    <td class="text-end @VarClass(r.CostVariance)">@Signed(r.CostVariance, "C0") @(r.CostVariancePct is null ? "" : $"({Signed(r.CostVariancePct.Value, "0.0")}%)")</td>
                    <td class="text-end">@r.EacCost.ToString("C0")</td>
                    <td class="text-end @VarClass(r.EacCostVariance)">@Signed(r.EacCostVariance, "C0") @(r.EacCostVariancePct is null ? "" : $"({Signed(r.EacCostVariancePct.Value, "0.0")}%)")</td>
                </tr>
            }
            @if (v.ByResourceType.Count == 0) { <tr><td colspan="8" class="text-muted">Nothing yet.</td></tr> }
            </tbody>
        </table>
        </div>

        <h2 class="h5 mt-4">By cost category <span class="text-muted small fw-normal">(imported time is labor; adjustments count against their category)</span></h2>
        <div class="table-responsive">
        <table class="table table-sm" id="variance-by-category">
            <thead><tr><th>Category</th><th class="text-end">Baseline $</th><th class="text-end">Actual $</th><th class="text-end">Variance</th><th class="text-end">EAC $</th><th class="text-end">Projected</th></tr></thead>
            <tbody>
            @foreach (var r in v.ByCategory)
            {
                <tr>
                    <td>@r.Label</td>
                    <td class="text-end">@r.BaselineCost.ToString("C0")</td>
                    <td class="text-end">@r.ActualCost.ToString("C0")</td>
                    <td class="text-end @VarClass(r.CostVariance)">@Signed(r.CostVariance, "C0") @(r.CostVariancePct is null ? "" : $"({Signed(r.CostVariancePct.Value, "0.0")}%)")</td>
                    <td class="text-end">@r.EacCost.ToString("C0")</td>
                    <td class="text-end @VarClass(r.EacCostVariance)">@Signed(r.EacCostVariance, "C0") @(r.EacCostVariancePct is null ? "" : $"({Signed(r.EacCostVariancePct.Value, "0.0")}%)")</td>
                </tr>
            }
            @if (v.ByCategory.Count == 0) { <tr><td colspan="6" class="text-muted">Nothing yet.</td></tr> }
            </tbody>
        </table>
        </div>
    </div>
</div>

<h2 class="h5 mt-4">Adjustments</h2>
<p class="text-muted small">Manual corrections to actuals (e.g. vendor invoices not in the time system, software license invoices). Adjustments add to sourced actuals, count against their cost category, and are audited.</p>
<div class="table-responsive">
<table class="table table-sm align-middle">
    <thead><tr><th>Date</th><th>By</th><th>Category</th><th>Reason</th><th class="text-end">Hours</th><th class="text-end">Cost</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model.Adjustments)
    {
        <tr>
            <td class="small">@a.CreatedAt.ToString("yyyy-MM-dd")</td>
            <td class="small">@a.CreatedBy</td>
            <td>@VarianceCalculator.CategoryLabel(a.Category)</td>
            <td>@a.Reason</td>
            <td class="text-end">@Signed(a.Hours, "N1")</td>
            <td class="text-end">@Signed(a.Cost, "C0")</td>
            <td class="text-end">
                @if (Model.CanManage)
                {
                    <form asp-action="DeleteAdjustment" asp-route-id="@i.Id" asp-route-adjustmentId="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this adjustment?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">&times;</button>
                    </form>
                }
            </td>
        </tr>
    }
    @if (Model.Adjustments.Count == 0) { <tr><td colspan="7" class="text-muted">No adjustments.</td></tr> }
    </tbody>
</table>
</div>
@if (Model.CanManage)
{
    <form asp-action="AddAdjustment" asp-route-id="@i.Id" method="post" class="row g-2 align-items-end mb-4">
        <div class="col-md-2">
            <label for="category" class="form-label small mb-0">Category</label>
            <select name="Category" id="category" asp-items="Html.GetEnumSelectList<CostCategory>()" class="form-select form-select-sm"></select>
        </div>
        <div class="col-md-2">
            <label for="hours" class="form-label small mb-0">Hours (&plusmn;)</label>
            <input name="Hours" id="hours" type="number" step="0.5" value="0" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-2">
            <label for="cost" class="form-label small mb-0">Cost (&plusmn;)</label>
            <input name="Cost" id="cost" type="number" step="0.01" value="0" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-4">
            <label for="reason" class="form-label small mb-0">Reason</label>
            <input name="Reason" id="reason" class="form-control form-control-sm" placeholder="e.g. Vendor invoice INV-2231 for March" required maxlength="1000" />
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary btn-sm w-100">Add adjustment</button></div>
    </form>
}

<h2 class="h5 mt-4">Imported entries (@Model.Entries.Count)</h2>
<div class="table-responsive">
<table class="table table-sm align-middle">
    <thead><tr><th>Date</th><th>Person</th><th>Reference</th><th>Import</th><th class="text-end">Hours</th><th class="text-end">Cost</th></tr></thead>
    <tbody>
    @foreach (var e in Model.Entries.Take(500))
    {
        <tr>
            <td class="small">@e.WorkDate.ToString("yyyy-MM-dd")</td>
            <td>@(e.Person?.DisplayName ?? e.ExternalPersonId)</td>
            <td class="small text-muted">@e.SourceReference</td>
            <td class="small">#@e.ActualsImportId @e.ActualsImport?.Source</td>
            <td class="text-end">@e.Hours.ToString("N1")</td>
            <td class="text-end">
                @if (e.EffectiveCost is null) { <span class="badge bg-warning text-dark">Unpriced</span> } else { <text>@e.EffectiveCost.Value.ToString("C0")</text> }
            </td>
        </tr>
    }
    @if (Model.Entries.Count == 0) { <tr><td colspan="6" class="text-muted">No actuals imported for this initiative yet.</td></tr> }
    @if (Model.Entries.Count > 500) { <tr><td colspan="6" class="text-muted">Showing the 500 most recent of @Model.Entries.Count entries.</td></tr> }
    </tbody>
</table>
</div>
