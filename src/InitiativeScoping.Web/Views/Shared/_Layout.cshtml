@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string NavCls(string a, params string[] controllers) =>
        a == area && controllers.Contains(controller) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Initiative Scoping</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InitiativeScoping.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Initiative Scoping</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="@NavCls("", "Home")" data-shortcut="g h" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavCls("", "Initiatives")" data-shortcut="g i" asp-area="" asp-controller="Initiatives" asp-action="Index">Initiatives</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavCls("", "Portfolio")" data-shortcut="g p" asp-area="" asp-controller="Portfolio" asp-action="Index">Portfolio</a>
                        </li>
                        @if (User.IsInRole(InitiativeScoping.Application.AppRoles.Admin))
                        {
                            <li class="nav-item">
                                <a class="@NavCls("", "Actuals")" data-shortcut="g c" asp-area="" asp-controller="Actuals" asp-action="Index">Actuals</a>
                            </li>
                            <li class="nav-item">
                                <a class="@(area == "Admin" && controller != "Users" ? "nav-link active" : "nav-link")" asp-area="Admin" asp-controller="BusinessUnits" asp-action="Index" data-shortcut="g a">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavCls("", "Lifecycle")" asp-area="" asp-controller="Lifecycle" asp-action="Pending">Re-baselines</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavCls("", "Audit")" data-shortcut="g l" asp-area="" asp-controller="Audit" asp-action="Index">Audit</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavCls("Admin", "Users")" asp-area="Admin" asp-controller="Users" asp-action="Index" data-shortcut="g u">Users</a>
                            </li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (InitiativeScoping.Application.AppRoles.All.Any(User.IsInRole))
                        {
                            <form asp-area="" asp-controller="Search" asp-action="Index" method="get" role="search" class="d-flex align-items-center me-3 nav-search">
                                <label for="global-search" class="visually-hidden">Search</label>
                                <input id="global-search" type="search" name="q" class="form-control form-control-sm" placeholder="Search…  /" aria-keyshortcuts="/" minlength="2" autocomplete="off" value="@(controller == "Search" ? Context.Request.Query["q"].ToString() : "")" />
                            </form>
                        }
                        <form asp-area="" asp-controller="Access" asp-action="EndSession" method="post" class="d-flex align-items-center gap-2">
                            <span class="navbar-text small text-muted">@User.Identity.Name</span>
                            <button type="submit" class="btn btn-link btn-sm p-0 text-dark">Sign out</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <partial name="_Flash" />
    <div class="container">
        <main id="main" role="main" class="pb-3" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.UtcNow.Year - Initiative Scoping
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
