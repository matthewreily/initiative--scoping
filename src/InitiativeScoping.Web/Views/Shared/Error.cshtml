@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Something went wrong</h1>
<p>An unexpected error occurred while processing your request. It has been logged; if the problem persists, share the request ID below with an administrator.</p>
<p><a asp-controller="Home" asp-action="Index">Return to home</a></p>

@if (Model.ShowRequestId)
{
    <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
}
