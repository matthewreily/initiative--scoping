@model PortfolioModel
@{
    ViewData["Title"] = "Portfolio";
    var p = Model.Portfolio;
    var maxCost = p.Rows.Count == 0 ? 0m : p.Rows.Max(r => Math.Max(Math.Max(r.ForecastCost, r.BaselineCost), r.ActualCost));
    string Pct(decimal value) => maxCost <= 0 ? "0" : Math.Round(value / maxCost * 100m, 1).ToString(System.Globalization.CultureInfo.InvariantCulture);
    string Signed(decimal v, string fmt) => (v > 0 ? "+" : "") + v.ToString(fmt);
    string Inv(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    string VarianceClass(decimal? pct, bool over) => over ? "text-danger fw-semibold" : pct is null ? "text-muted" : pct > 0 ? "text-warning-emphasis" : "text-success";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Portfolio</h1>
    @if (Model.CanExport && p.Count > 0)
    {
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
            <ul class="dropdown-menu dropdown-menu-end">
                @foreach (var f in Model.Formats.OrderBy(f => f == "xlsx" ? 0 : 1))
                {
                    <li><a class="dropdown-item" asp-action="Export" asp-route-format="@f" asp-route-status="@Model.Status" asp-route-businessUnitId="@Model.BusinessUnitId" asp-route-includeClosed="@Model.IncludeClosed">@(f == "xlsx" ? "Excel (.xlsx)" : "CSV")</a></li>
                }
            </ul>
        </div>
    }
</div>

<form method="get" data-remember-filters class="row g-2 align-items-center mb-3">
    <div class="col-md-3">
        <select name="status" class="form-select form-select-sm" aria-label="Filter by status" asp-for="Status" asp-items="Html.GetEnumSelectList<InitiativeStatus>()">
            <option value="">All open statuses</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="businessUnitId" class="form-select form-select-sm" aria-label="Filter by business unit" asp-for="BusinessUnitId" asp-items="Model.BusinessUnits">
            <option value="">All business units</option>
        </select>
    </div>
    <div class="col-md-3 form-check ms-2">
        <input type="checkbox" class="form-check-input" id="includeClosed" name="includeClosed" value="true" checked="@Model.IncludeClosed" />
        <label class="form-check-label small" for="includeClosed">Include Complete / Cancelled</label>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Filter</button>
        <a asp-action="Index" class="btn btn-link btn-sm" data-filter-clear>Clear</a>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Initiatives</div><div class="fs-3">@p.Count</div><div class="small text-muted">@p.Baselined baselined</div></div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Forecast cost<help for="forecast-cost" /></div><div class="fs-3" title="@p.ForecastCost.ToString("C0")">@Money.Compact(p.ForecastCost)</div><div class="small text-muted">@p.ForecastHours.ToString("N0") h</div>
        @if (p.ContingencyCost > 0) { <div class="small text-muted" id="portfolio-contingency" title="@p.ForecastCostWithContingency.ToString("C0")">@Money.Compact(p.ForecastCostWithContingency) incl. @Money.Compact(p.ContingencyCost) contingency</div> }
        @if (p.LowConfidence > 0) { <div class="small text-danger">@p.LowConfidence low-confidence</div> }</div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Internal / Vendor / Non-labor<help for="internal-vendor" /></div><div class="fs-6" title="@p.InternalForecastCost.ToString("C0") / @p.VendorForecastCost.ToString("C0") / @p.NonLaborForecastCost.ToString("C0")">@Money.Compact(p.InternalForecastCost) / @Money.Compact(p.VendorForecastCost) / @Money.Compact(p.NonLaborForecastCost)</div>
        @if (p.ForecastCost > 0)
        {
            var internalPct = Math.Round(p.InternalForecastCost / p.ForecastCost * 100m);
            var vendorPct = Math.Round(p.VendorForecastCost / p.ForecastCost * 100m);
            <div class="progress mt-1" style="height: 6px" title="Internal @internalPct% · Vendor @vendorPct% · Non-labor @(100 - internalPct - vendorPct)%"><div class="progress-bar bg-primary" style="width: @internalPct%"></div><div class="progress-bar bg-info" style="width: @vendorPct%"></div><div class="progress-bar bg-warning" style="width: @(100 - internalPct - vendorPct)%"></div></div>
        }
    </div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Baseline cost<help for="baseline" /></div><div class="fs-3" title="@p.BaselineCost.ToString("C0")">@Money.Compact(p.BaselineCost)</div><div class="small text-muted">@p.BaselineHours.ToString("N0") h</div></div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Actual cost to date<help for="actual" /></div><div class="fs-3" title="@p.ActualCost.ToString("C0")">@Money.Compact(p.ActualCost)</div><div class="small text-muted">@p.ActualHours.ToString("N0") h</div></div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="card h-100 @(p.OverBudget > 0 ? "border-danger" : "")" id="portfolio-budget"><div class="card-body"><div class="text-muted small">Approved budget<help for="budget" /></div>
        @if (p.Budgeted == 0)
        {
            <div class="fs-3 text-muted">—</div><div class="small text-muted">No budgets recorded</div>
        }
        else
        {
            <div class="fs-3" title="@p.ApprovedBudget.ToString("C0")">@Money.Compact(p.ApprovedBudget)</div>
            <div class="small @(p.BudgetRemaining < 0 ? "text-danger" : "text-muted")" title="@Signed(p.BudgetRemaining, "C0") across @p.Budgeted budgeted initiative(s)">@(p.BudgetRemaining < 0 ? "−" : "")@Money.Compact(Math.Abs(p.BudgetRemaining)) @(p.BudgetRemaining < 0 ? "over" : "remaining")
                @if (p.OverBudget > 0) { <span class="badge bg-danger ms-1">@p.OverBudget over budget</span> }
            </div>
        }
    </div></div></div>
    <div class="col-6 col-md-4 col-xl-2"><div class="card h-100 @(p.OverThreshold > 0 ? "border-danger" : "")"><div class="card-body"><div class="text-muted small">Variance vs. baseline<help for="variance" /></div>
        <div class="fs-3 @VarianceClass(p.CostVariancePct, false)" title="@Signed(p.CostVariance, "C0")">@(p.CostVariance > 0 ? "+" : "")@Money.Compact(p.CostVariance)</div>
        <div class="small">@(p.CostVariancePct is null ? "n/a" : Signed(p.CostVariancePct.Value, "N1") + "%")
            @if (p.OverThreshold > 0) { <span class="badge bg-danger ms-1">@p.OverThreshold over threshold</span> }
            @if (p.Unpriced > 0) { <span class="badge bg-warning text-dark ms-1">@p.Unpriced unpriced</span> }
        </div></div></div></div>
</div>

@if (p.Count == 0)
{
    <div class="alert alert-light border">No initiatives match the current filter.</div>
}
else
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between">
            <span>Forecast vs. baseline vs. actual <span class="text-muted small fw-normal">(initiatives on this page)</span></span>
            <span class="small text-muted"><span class="badge bg-secondary">&nbsp;</span> forecast &nbsp; <span class="badge bg-primary">&nbsp;</span> baseline &nbsp; <span class="badge bg-success">&nbsp;</span> actual</span>
        </div>
        <div class="card-body">
            @foreach (var r in Model.PageRows)
            {
                <div class="row align-items-center mb-2">
                    <div class="col-md-3 text-truncate"><a asp-controller="Initiatives" asp-action="Details" asp-route-id="@r.Initiative.Id">@r.Initiative.Name</a> <span class="text-muted small">@r.Initiative.BusinessUnit?.Name</span></div>
                    <div class="col-md-9">
                        <div class="progress mb-1" style="height: 6px" title="Forecast @r.ForecastCost.ToString("C0")"><div class="progress-bar bg-secondary" style="width: @Pct(r.ForecastCost)%"></div></div>
                        <div class="progress mb-1" style="height: 6px" title="Baseline @r.BaselineCost.ToString("C0")"><div class="progress-bar bg-primary" style="width: @Pct(r.BaselineCost)%"></div></div>
                        <div class="progress" style="height: 6px" title="Actual @r.ActualCost.ToString("C0")"><div class="progress-bar @(r.ExceedsThreshold ? "bg-danger" : "bg-success")" style="width: @Pct(r.ActualCost)%"></div></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="table-responsive">
    <table data-columns class="table table-sm align-middle" id="portfolio-table">
        <thead>
        <tr>
            <th class="@Model.SortClass("initiative")" aria-sort="@Model.AriaSort("initiative")"><a class="sort-link" href="@Model.SortUrl(Url, "initiative")">Initiative</a></th>
            <th class="d-none d-md-table-cell @Model.SortClass("bu")" aria-sort="@Model.AriaSort("bu")"><a class="sort-link" href="@Model.SortUrl(Url, "bu")">Business unit</a></th>
            <th class="d-none d-md-table-cell @Model.SortClass("status")" aria-sort="@Model.AriaSort("status")"><a class="sort-link" href="@Model.SortUrl(Url, "status")">Status</a></th>
            <th class="text-end d-none d-lg-table-cell @Model.SortClass("forecast")" aria-sort="@Model.AriaSort("forecast")"><a class="sort-link" href="@Model.SortUrl(Url, "forecast")">Forecast</a><help for="forecast-cost" /></th>
            <th class="text-end d-none d-xl-table-cell @Model.SortClass("contingency")" aria-sort="@Model.AriaSort("contingency")"><a class="sort-link" href="@Model.SortUrl(Url, "contingency")">Contingency</a><help for="contingency" /></th>
            <th class="text-end @Model.SortClass("baseline")" aria-sort="@Model.AriaSort("baseline")"><a class="sort-link" href="@Model.SortUrl(Url, "baseline")">Baseline</a><help for="baseline" /></th>
            <th class="text-end @Model.SortClass("actual")" aria-sort="@Model.AriaSort("actual")"><a class="sort-link" href="@Model.SortUrl(Url, "actual")">Actual</a><help for="actual" /></th>
            <th class="text-end @Model.SortClass("variance")" aria-sort="@Model.AriaSort("variance")"><a class="sort-link" href="@Model.SortUrl(Url, "variance")">Variance</a><help for="variance" /></th>
            <th class="text-end @Model.SortClass("varpct")" aria-sort="@Model.AriaSort("varpct")"><a class="sort-link" href="@Model.SortUrl(Url, "varpct")">Var %</a></th>
            <th class="text-end @Model.SortClass("eac")" aria-sort="@Model.AriaSort("eac")"><a class="sort-link" href="@Model.SortUrl(Url, "eac")">EAC</a><help for="eac" /></th>
            <th class="text-end @Model.SortClass("budget")" aria-sort="@Model.AriaSort("budget")"><a class="sort-link" href="@Model.SortUrl(Url, "budget")">Budget</a><help for="budget" /></th>
            <th class="text-end @Model.SortClass("remaining")" aria-sort="@Model.AriaSort("remaining")"><a class="sort-link" href="@Model.SortUrl(Url, "remaining")">Remaining</a><help for="remaining" /></th>
            <th style="min-width: 110px" class="@Model.SortClass("burn")" aria-sort="@Model.AriaSort("burn")"><a class="sort-link" href="@Model.SortUrl(Url, "burn")">Burn</a><help for="burn" /></th>
            <th>Flags<help for="flags" /></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.PageRows)
        {
            var i = r.Initiative;
            <tr class="@(r.ExceedsThreshold || r.OverBudget ? "table-danger" : "")">
                <td><a asp-controller="Initiatives" asp-action="Details" asp-route-id="@i.Id">@i.Name</a></td>
                <td class="d-none d-md-table-cell">@i.BusinessUnit?.Name</td>
                <td class="d-none d-md-table-cell"><partial name="~/Views/Initiatives/_StatusBadge.cshtml" model="i.Status" /></td>
                <td class="text-end d-none d-lg-table-cell" data-sort="@Inv(r.ForecastCost)">@r.ForecastCost.ToString("C0")<div class="small text-muted">@r.ForecastHours.ToString("N0") h</div></td>
                <td class="text-end d-none d-xl-table-cell" data-sort="@Inv(r.ContingencyCost)">
                    @if (r.ContingencyPct > 0) { @r.ContingencyCost.ToString("C0") <div class="small text-muted">@r.ContingencyPct.ToString("0.##")% &middot; @r.ForecastCostWithContingency.ToString("C0") total</div> }
                    else { <span class="text-muted">—</span> }
                </td>
                <td class="text-end" data-sort="@(r.HasBaseline ? Inv(r.BaselineCost) : "")">
                    @if (r.HasBaseline) { @r.BaselineCost.ToString("C0") <div class="small text-muted">v@(r.BaselineVersion) &middot; @r.BaselineHours.ToString("N0") h</div> }
                    else { <span class="text-muted">—</span> }
                </td>
                <td class="text-end" data-sort="@Inv(r.ActualCost)">@r.ActualCost.ToString("C0")<div class="small text-muted">@r.ActualHours.ToString("N0") h</div></td>
                <td class="text-end @VarianceClass(r.CostVariancePct, r.ExceedsThreshold)" data-sort="@(r.HasBaseline ? Inv(r.CostVariance) : "")">@(r.HasBaseline ? Signed(r.CostVariance, "C0") : "—")</td>
                <td class="text-end @VarianceClass(r.CostVariancePct, r.ExceedsThreshold)" data-sort="@Inv(r.CostVariancePct)">@(r.CostVariancePct is null ? "—" : Signed(r.CostVariancePct.Value, "N1") + "%")</td>
                <td class="text-end" title="Actual + estimate to complete (schedule-based)" data-sort="@(r.HasBaseline ? Inv(r.EacCost) : "")">
                    @if (r.HasBaseline) { @r.EacCost.ToString("C0") <div class="small @VarianceClass(r.Variance.EacCostVariancePct, r.Variance.EacExceedsThreshold)">@(r.Variance.EacCostVariancePct is null ? "" : Signed(r.Variance.EacCostVariancePct.Value, "N1") + "%")</div> }
                    else { <span class="text-muted">—</span> }
                </td>
                <td class="text-end" data-sort="@(r.ApprovedBudget is null ? "" : Inv(r.ApprovedBudget.Value))">
                    @if (r.ApprovedBudget is not null) { @r.ApprovedBudget.Value.ToString("C0") @if (!string.IsNullOrEmpty(r.Budget.FiscalYear)) { <div class="small text-muted">@r.Budget.FiscalYear</div> } }
                    else { <span class="text-muted">—</span> }
                </td>
                <td class="text-end @(r.OverBudget ? "text-danger fw-semibold" : "")" title="Budget minus @(r.Budget.UsesEac ? "EAC" : "forecast incl. contingency")" data-sort="@(r.BudgetRemaining is null ? "" : Inv(r.BudgetRemaining.Value))">
                    @if (r.BudgetRemaining is not null) { @Signed(r.BudgetRemaining.Value, "C0") @if (r.Budget.UtilizationPct is not null) { <div class="small @(r.OverBudget ? "" : "text-muted")">@r.Budget.UtilizationPct.Value.ToString("N0")% used</div> } }
                    else { <span class="text-muted">—</span> }
                </td>
                <td data-sort="@Inv(r.BurnPct)">
                    <div class="progress" style="height: 8px" role="progressbar" aria-label="Burn" aria-valuenow="@r.BurnPct.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100" title="@r.BurnPct% of @(r.HasBaseline ? "baseline" : "forecast") spent">
                        <div class="progress-bar @(r.ExceedsThreshold ? "bg-danger" : r.BurnPct >= 90 ? "bg-warning" : "bg-success")" style="width: @Math.Min(r.BurnPct, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <div class="small text-muted">@r.BurnPct.ToString("N0")%@(r.ExceedsThreshold ? " · over" : "")</div>
                </td>
                <td>
                    @if (r.ExceedsThreshold) { <span class="badge bg-danger" title="Cost variance exceeds @r.Variance.ThresholdPct%">Over threshold</span> }
                    @if (r.OverBudget) { <span class="badge bg-danger" title="Expected cost exceeds the approved budget by @Math.Abs(r.BudgetRemaining!.Value).ToString("C0")">Over budget</span> }
                    else if (r.Budget.NearBudget) { <span class="badge bg-warning text-dark" title="@r.Budget.UtilizationPct% of the approved budget">Near budget</span> }
                    @if (r.HasUnpricedForecast) { <span class="badge bg-warning text-dark" title="One or more allocations have no matching rate">Unpriced forecast</span> }
                    @if (r.HasUnpricedActuals) { <span class="badge bg-warning text-dark" title="@r.Variance.UnpricedEntries actual rows without a rate">Unpriced actuals</span> }
                    @if (i.OpenRebaseline is not null) { <span class="badge bg-info text-dark">Re-baseline @i.OpenRebaseline.Status.ToString().ToLower()</span> }
                    @if (r.PendingChangeRequests > 0) { <a class="badge text-bg-warning text-decoration-none" asp-controller="Initiatives" asp-action="Details" asp-route-id="@i.Id" asp-fragment="pane-changes" title="@(r.PendingChangeCostImpact is null ? "Change requests awaiting approval" : $"Estimated cost impact {r.PendingChangeCostImpact.Value:+#,##0;-#,##0;0}")">@r.PendingChangeRequests change @(r.PendingChangeRequests == 1 ? "request" : "requests") pending</a> }
                    @if (r.ApprovedChangeRequests > 0) { <a class="badge text-bg-info text-decoration-none" asp-controller="Initiatives" asp-action="Details" asp-route-id="@i.Id" asp-fragment="pane-changes" title="Approved change requests awaiting the next baseline">@r.ApprovedChangeRequests change @(r.ApprovedChangeRequests == 1 ? "request" : "requests") approved</a> }
                    <partial name="_Confidence" model="r.Confidence" />
                </td>
            </tr>
        }
        </tbody>
        <tfoot class="fw-semibold">
        <tr>
            <td>Total (@p.Count)</td>
            <td class="d-none d-md-table-cell"></td>
            <td class="d-none d-md-table-cell"></td>
            <td class="text-end d-none d-lg-table-cell">@p.ForecastCost.ToString("C0")</td>
            <td class="text-end d-none d-xl-table-cell">@p.ContingencyCost.ToString("C0")</td>
            <td class="text-end">@p.BaselineCost.ToString("C0")</td>
            <td class="text-end">@p.ActualCost.ToString("C0")</td>
            <td class="text-end @VarianceClass(p.CostVariancePct, false)">@Signed(p.CostVariance, "C0")</td>
            <td class="text-end @VarianceClass(p.CostVariancePct, false)">@(p.CostVariancePct is null ? "—" : Signed(p.CostVariancePct.Value, "N1") + "%")</td>
            <td class="text-end">@p.EacCost.ToString("C0")</td>
            <td class="text-end">@(p.Budgeted > 0 ? p.ApprovedBudget.ToString("C0") : "—")</td>
            <td class="text-end @(p.BudgetRemaining < 0 ? "text-danger" : "")">@(p.Budgeted > 0 ? Signed(p.BudgetRemaining, "C0") : "—")</td>
            <td colspan="2"></td>
        </tr>
        </tfoot>
    </table>
    </div>
    <partial name="_Pager" model="Model.Pager(Url)" />

    <div class="card mb-4" id="by-month">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Cost by month</span>
            <span class="small text-muted">Forecast, baseline and actual across the initiatives shown</span>
        </div>
        <div class="card-body">
            <partial name="_MonthlyPhasing" model="p.ByMonth" view-data="@(new ViewDataDictionary(ViewData) { { "Id", "portfolio-phasing" } })" />
        </div>
    </div>

    <div class="card mb-4" id="by-fiscal-period">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Cost by fiscal year and quarter</span>
            <span class="small text-muted">Capex / Opex split across the initiatives shown</span>
        </div>
        <div class="card-body">
            <partial name="_FiscalPeriods" model="new FiscalPeriodsViewModel(p.ByMonth, Model.Fiscal)" view-data="@(new ViewDataDictionary(ViewData) { { "Id", "portfolio-fiscal" } })" />
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card"><div class="card-header">By sponsor business unit</div>
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Business unit</th><th class="text-end">#</th><th class="text-end">Forecast</th><th class="text-end">Baseline</th><th class="text-end">Actual</th><th class="text-end">Var %</th></tr></thead>
                    <tbody>
                    @foreach (var g in p.ByBusinessUnit)
                    {
                        <tr>
                            <td>@g.Label @if (g.OverThreshold > 0) { <span class="badge bg-danger ms-1">@g.OverThreshold</span> }</td>
                            <td class="text-end">@g.Count</td>
                            <td class="text-end">@g.ForecastCost.ToString("C0")</td>
                            <td class="text-end">@g.BaselineCost.ToString("C0")</td>
                            <td class="text-end">@g.ActualCost.ToString("C0")</td>
                            <td class="text-end @VarianceClass(g.CostVariancePct, false)">@(g.CostVariancePct is null ? "—" : Signed(g.CostVariancePct.Value, "N1") + "%")</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card"><div class="card-header">By status</div>
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Status</th><th class="text-end">#</th><th class="text-end">Forecast</th><th class="text-end">Baseline</th><th class="text-end">Actual</th><th class="text-end">Var %</th></tr></thead>
                    <tbody>
                    @foreach (var g in p.ByStatus)
                    {
                        <tr>
                            <td>@g.Label @if (g.OverThreshold > 0) { <span class="badge bg-danger ms-1">@g.OverThreshold</span> }</td>
                            <td class="text-end">@g.Count</td>
                            <td class="text-end">@g.ForecastCost.ToString("C0")</td>
                            <td class="text-end">@g.BaselineCost.ToString("C0")</td>
                            <td class="text-end">@g.ActualCost.ToString("C0")</td>
                            <td class="text-end @VarianceClass(g.CostVariancePct, false)">@(g.CostVariancePct is null ? "—" : Signed(g.CostVariancePct.Value, "N1") + "%")</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card" id="by-resourcing-bu"><div class="card-header">Labor by resourcing business unit</div>
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Business unit</th><th class="text-end">#</th><th class="text-end">Hours</th><th class="text-end">Forecast labor</th></tr></thead>
                    <tbody>
                    @foreach (var g in p.ByResourcingBusinessUnit)
                    {
                        <tr>
                            <td>@g.Label</td>
                            <td class="text-end">@g.Initiatives</td>
                            <td class="text-end">@g.Hours.ToString("N1")</td>
                            <td class="text-end">@g.ForecastCost.ToString("C0") @if (g.HasUnpriced) { <span class="text-warning" title="Includes unpriced allocations">&#9888;</span> }</td>
                        </tr>
                    }
                    @if (p.ByResourcingBusinessUnit.Count == 0) { <tr><td colspan="4" class="text-muted">Nothing allocated.</td></tr> }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card" id="by-vendor"><div class="card-header">Labor by vendor</div>
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Vendor</th><th class="text-end">#</th><th class="text-end">Hours</th><th class="text-end">Forecast labor</th></tr></thead>
                    <tbody>
                    @foreach (var g in p.ByVendor)
                    {
                        <tr>
                            <td>@g.Label</td>
                            <td class="text-end">@g.Initiatives</td>
                            <td class="text-end">@g.Hours.ToString("N1")</td>
                            <td class="text-end">@g.ForecastCost.ToString("C0") @if (g.HasUnpriced) { <span class="text-warning" title="Includes unpriced allocations">&#9888;</span> }</td>
                        </tr>
                    }
                    @if (p.ByVendor.Count == 0) { <tr><td colspan="4" class="text-muted">No vendor allocations.</td></tr> }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>
}
