@model InitiativeEditModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Initiative" : "Edit Initiative";
    var businessUnits = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.BusinessUnits;
    var sizeOptions = (IReadOnlyList<SizeOption>)ViewBag.SizeOptions;
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Initiatives</a></li><li class="breadcrumb-item active">@ViewData["Title"]</li></ol></nav>
<h1 class="h3">@ViewData["Title"]</h1>
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="BusinessUnitId" class="form-label"></label>
            <select asp-for="BusinessUnitId" asp-items="businessUnits" class="form-select"><option value="">Select…</option></select>
            <span asp-validation-for="BusinessUnitId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SponsoringTeam" class="form-label"></label>
            <input asp-for="SponsoringTeam" class="form-control" />
            <span asp-validation-for="SponsoringTeam" class="text-danger"></span>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="SizingMethod" class="form-label"></label>
            <select asp-for="SizingMethod" class="form-select" id="sizing-method">
                <option value="@SizingMethod.Direct">Direct hours</option>
                <option value="@SizingMethod.TShirt">T-shirt</option>
                <option value="@SizingMethod.StoryPoints">Story points</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="SizeKey" class="form-label"></label>
            <select asp-for="SizeKey" class="form-select" id="size-key">
                <option value="">Select…</option>
                @foreach (var o in sizeOptions)
                {
                    <option value="@o.Key" data-method="@o.Method" selected="@(o.Method == Model.SizingMethod && o.Key == Model.SizeKey)">@o.Label</option>
                }
            </select>
            <span asp-validation-for="SizeKey" class="text-danger"></span>
            <div class="form-text" id="size-key-empty" hidden>No sizes are defined for this method. Ask an administrator to add an allocation template.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="VarianceThresholdPct" class="form-label"></label>
            <input asp-for="VarianceThresholdPct" class="form-control" type="number" step="0.5" min="0" />
            <span asp-validation-for="VarianceThresholdPct" class="text-danger"></span>
        </div>
    </div>
    <fieldset class="row g-3 mb-3">
        <legend class="h6 mb-0">Schedule</legend>
        <div class="col-md-4">
            <label asp-for="PlanningMode" class="form-label"></label>
            <select asp-for="PlanningMode" class="form-select" id="planning-mode">
                <option value="@PlanningMode.EffortDriven">Effort-driven (enter hours)</option>
                <option value="@PlanningMode.FixedDuration">Fixed duration (hours from staffing %)</option>
            </select>
            <div class="form-text" id="planning-mode-help"></div>
        </div>
        <div class="col-md-4">
            <label asp-for="TargetStart" class="form-label"></label>
            <input asp-for="TargetStart" class="form-control" id="target-start" />
            <span asp-validation-for="TargetStart" class="text-danger"></span>
        </div>
        <div class="col-md-4" id="target-end-group">
            <label asp-for="TargetEnd" class="form-label"></label>
            <input asp-for="TargetEnd" class="form-control" id="target-end" />
            <span asp-validation-for="TargetEnd" class="text-danger"></span>
            <div class="form-text" id="duration-summary"></div>
        </div>
    </fieldset>
    <button type="submit" class="btn btn-primary">Save</button>
    @if (isNew)
    {
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    }
    else
    {
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    }
</form>
@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        (function () {
            const method = document.getElementById('sizing-method');
            const key = document.getElementById('size-key');
            const empty = document.getElementById('size-key-empty');
            const names = { '@((int)SizingMethod.Direct)': '@SizingMethod.Direct', '@((int)SizingMethod.TShirt)': '@SizingMethod.TShirt', '@((int)SizingMethod.StoryPoints)': '@SizingMethod.StoryPoints' };
            function sync() {
                const current = names[method.value] || method.value;
                const direct = current === '@SizingMethod.Direct';
                let visible = 0;
                for (const opt of key.options) {
                    if (!opt.value) continue;
                    const show = !direct && opt.dataset.method === current;
                    opt.hidden = !show;
                    opt.disabled = !show;
                    if (show) visible++;
                    if (!show && opt.selected) key.value = '';
                }
                key.disabled = direct;
                if (direct) key.value = '';
                empty.hidden = direct || visible > 0;
            }
            method.addEventListener('change', sync);
            sync();

            const mode = document.getElementById('planning-mode');
            const endGroup = document.getElementById('target-end-group');
            const start = document.getElementById('target-start');
            const end = document.getElementById('target-end');
            const help = document.getElementById('planning-mode-help');
            const summary = document.getElementById('duration-summary');
            const modeNames = { '@((int)PlanningMode.EffortDriven)': '@PlanningMode.EffortDriven', '@((int)PlanningMode.FixedDuration)': '@PlanningMode.FixedDuration' };
            function syncMode() {
                const fixed = (modeNames[mode.value] || mode.value) === '@PlanningMode.FixedDuration';
                endGroup.hidden = !fixed;
                end.required = fixed;
                help.textContent = fixed
                    ? 'Phases must tile start–end; allocation hours = staffing % × working days (Mon–Fri minus holidays) × hours/day.'
                    : 'Allocation hours are entered directly; phase dates are informational.';
                if (fixed && start.value && end.value) {
                    const days = Math.round((new Date(end.value) - new Date(start.value)) / 86400000) + 1;
                    summary.textContent = days > 0 ? `${days} calendar days (~${(days / 7).toFixed(1)} weeks)` : 'Target end must be on or after target start.';
                } else {
                    summary.textContent = '';
                }
            }
            mode.addEventListener('change', syncMode);
            start.addEventListener('change', syncMode);
            end.addEventListener('change', syncMode);
            syncMode();
        })();
    </script>
}
