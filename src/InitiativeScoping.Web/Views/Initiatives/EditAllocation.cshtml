@model AllocationEditModel
@{
    var initiative = (Initiative)ViewBag.Initiative;
    var phases = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Phases;
    var rateOptions = (RateOptionsData)ViewBag.RateOptions;
    var currentSeniority = (SeniorityLevel?)ViewBag.CurrentSeniority;
    var seniorities = rateOptions.Seniorities.Any(s => s.Id == Model.SeniorityId) || currentSeniority is null
        ? rateOptions.Seniorities
        : rateOptions.Seniorities.Append(new NamedId(currentSeniority.Id, currentSeniority.Name + " (inactive)")).ToList();
    var locations = rateOptions.AllLocations.Append(Model.Location).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(l => l, StringComparer.OrdinalIgnoreCase);
    ViewData["Title"] = "Edit Allocation";
    var fixedDuration = initiative.PlanningMode == PlanningMode.FixedDuration;
}
<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="Index">Initiatives</a></li>
    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@initiative.Id">@initiative.Name</a></li>
    <li class="breadcrumb-item active">Edit allocation</li>
</ol></nav>
<h1 class="h3">Edit allocation</h1>
<p class="text-muted small">
    Participating business units: <strong>@string.Join(", ", rateOptions.BusinessUnits.Select(b => b.Name))</strong>. Only combinations with a published rate on the phase start date are selectable; rates are shared by every business unit.
    @if (!rateOptions.HasAnyPricing)
    {
        <span class="text-warning-emphasis">No published rate card has any rates yet — allocations will be unpriced until an admin adds rates.</span>
    }
    @if (User.IsInRole(InitiativeScoping.Application.AppRoles.Admin))
    {
        <a asp-area="Admin" asp-controller="RateCards" asp-action="Index">Manage rate cards</a>
    }
</p>
<form asp-action="EditAllocation" asp-route-id="@Model.Id" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="PhaseId" class="form-label"></label>
            <select asp-for="PhaseId" asp-items="phases" class="form-select"></select>
            <span asp-validation-for="PhaseId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BusinessUnitId" class="form-label"></label>
            <select asp-for="BusinessUnitId" asp-items="@(new SelectList(rateOptions.BusinessUnits, "Id", "Name"))" class="form-select"></select>
            <span asp-validation-for="BusinessUnitId" class="text-danger"></span>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="ResourceTypeId" class="form-label"></label>
            <select asp-for="ResourceTypeId" asp-items="@(new SelectList(rateOptions.AllResourceTypes, "Id", "Name"))" class="form-select"></select>
            <span asp-validation-for="ResourceTypeId" class="text-danger"></span>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label asp-for="SeniorityId" class="form-label"></label>
            <select asp-for="SeniorityId" asp-items="@(new SelectList(seniorities, "Id", "Name"))" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="Location" class="form-label"></label>
            <select asp-for="Location" asp-items="@(new SelectList(locations))" class="form-select"></select>
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ResourcingClass" class="form-label"></label>
            <select asp-for="ResourcingClass" asp-items="Html.GetEnumSelectList<ResourcingClass>()" class="form-select"></select>
        </div>
        <div class="col-md-3" data-vendor-field hidden>
            <label asp-for="VendorId" class="form-label"></label>
            <select asp-for="VendorId" asp-items="@(new SelectList(rateOptions.Vendors, "Id", "Name"))" class="form-select"></select>
            <span asp-validation-for="VendorId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label for="rate-preview" class="form-label">Hourly rate</label>
            <input id="rate-preview" class="form-control" readonly tabindex="-1" />
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" type="number" min="1" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        @if (fixedDuration)
        {
            <div class="col-md-3">
                <label asp-for="AllocationPercent" class="form-label"></label>
                <input asp-for="AllocationPercent" class="form-control" type="number" min="0.01" max="100" step="0.01" required />
                <span asp-validation-for="AllocationPercent" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label for="computed-hours" class="form-label">Hours (each, computed)</label>
                <input id="computed-hours" class="form-control" readonly tabindex="-1" value="@Model.EstimatedHours.ToString("N2")" aria-describedby="computed-hours-help" />
                <div class="form-text" id="computed-hours-help">Staffing % × phase working days × hours/day; 100% = all working hours in the phase.</div>
            </div>
        }
        else
        {
            <div class="col-md-3">
                <label asp-for="EstimatedHours" class="form-label"></label>
                <input asp-for="EstimatedHours" class="form-control" type="number" min="0.25" step="0.25" />
                <span asp-validation-for="EstimatedHours" class="text-danger"></span>
            </div>
        }
        <div class="col-md-3">
            <label asp-for="ContractReference" class="form-label"></label>
            <input asp-for="ContractReference" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="CostCenter" class="form-label"></label>
            <input asp-for="CostCenter" class="form-control" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@initiative.Id" class="btn btn-link">Cancel</a>
</form>
@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <partial name="_RateOptionsScript" model="@(new RateOptionsScriptModel("PhaseId", "ResourceTypeId", "SeniorityId", "Location", "ResourcingClass", "rate-preview", rateOptions, Model))" />
    @if (fixedDuration)
    {
        <partial name="_ComputedHoursScript" model="@(new ComputedHoursScriptModel("PhaseId", "AllocationPercent", "computed-hours", (IReadOnlyDictionary<int, int>)ViewBag.PhaseWorkingDays, (decimal)ViewBag.HoursPerDay))" />
    }
}
