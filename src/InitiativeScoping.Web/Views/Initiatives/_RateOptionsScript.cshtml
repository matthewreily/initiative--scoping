@model RateOptionsScriptModel
@{
    var cards = Model.Data.Cards.Select(c => new
    {
        id = c.CardId,
        effectiveStart = c.EffectiveStart.ToString("yyyy-MM-dd"),
        effectiveEnd = c.EffectiveEnd?.ToString("yyyy-MM-dd"),
        options = c.Options.Select(o => new { type = o.ResourceTypeId, seniority = o.SeniorityId, location = o.Location, cls = o.ResourcingClassId, vendor = o.VendorId, rate = o.Rate })
    });
    var phaseStarts = Model.Data.PhaseStarts.ToDictionary(p => p.Key, p => p.Value.ToString("yyyy-MM-dd"));
    var people = Model.Data.People.Select(p => new { id = p.Id, type = p.ResourceTypeId, seniority = p.SeniorityId, bu = p.BusinessUnitId, cls = p.ResourcingClassId, vendor = p.VendorId });
    var classes = Model.Data.Classes.Select(c => new { id = c.Id, isVendor = c.IsVendor, capex = c.DefaultCapexPercent });
}
<script>
    (function () {
        const byId = id => document.getElementById(id);
        const phase = byId('@Model.PhaseSelectId'), type = byId('@Model.ResourceTypeSelectId'), seniority = byId('@Model.SenioritySelectId');
        const location = byId('@Model.LocationSelectId'), cls = byId('@Model.ClassSelectId'), vendor = byId('@Model.VendorSelectId'), output = byId('@Model.RateOutputId');
        const vendorWrap = vendor ? (vendor.closest('[data-vendor-field]') ?? vendor) : null;
        const bu = byId('@Model.BusinessUnitSelectId'), person = byId('@Model.PersonSelectId'), quantity = byId('@Model.QuantityInputId');
        const people = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(people));
        const cards = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cards));
        const phaseStarts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(phaseStarts));
        // Resourcing class catalog: vendor-backed classes show the Vendor picker; each class carries the labor Capex % default.
        const classes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(classes));
        const classOf = id => classes.find(c => String(c.id) === String(id));
        const classIsVendor = id => classOf(id)?.isVendor === true;
        const capex = byId('@Model.CapexInputId');
        const current = { type: '@Model.Current.ResourceTypeId', seniority: '@Model.Current.SeniorityId', location: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Current.Location)), cls: '@Model.Current.ResourcingClassId', vendor: '@(Model.Current.VendorId?.ToString() ?? string.Empty)', people: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Current.PersonIds.Select(p => p.ToString()))) };
        let capexClass = current.cls;
        const money = new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' });

        function pricedFor(phaseId) {
            const start = phaseStarts[phaseId];
            if (!start) { return []; }
            // Same rule as RateResolver.EffectiveCard: window covers the phase start; latest effective start, then highest card id.
            const card = cards.filter(c => c.effectiveStart <= start && (!c.effectiveEnd || start <= c.effectiveEnd))
                .sort((a, b) => a.effectiveStart === b.effectiveStart ? b.id - a.id : (b.effectiveStart < a.effectiveStart ? -1 : 1))[0];
            return card ? card.options : [];
        }

        // Restricts a select to the given allowed values, keeping the preferred value when it is still allowed.
        function restrict(select, allowed, preferred, eq) {
            let kept = null;
            for (const opt of select.options) {
                const ok = allowed.length === 0 || allowed.some(a => eq(a, opt.value));
                opt.hidden = !ok;
                opt.disabled = !ok;
                if (ok && kept === null && (preferred === null || eq(preferred, opt.value))) { kept = opt.value; }
            }
            if (kept === null) { kept = Array.from(select.options).find(o => !o.disabled)?.value ?? select.value; }
            select.value = kept;
        }

        const same = (a, b) => String(a) === String(b);
        const sameText = (a, b) => String(a).toLowerCase() === String(b).toLowerCase();
        const sameVendor = (a, b) => String(a ?? '') === String(b ?? '');
        const isVendor = () => classIsVendor(cls.value);
        // Mirrors RateResolver.VendorMatches: a vendor row naming no vendor is a generic rate for any vendor.
        const vendorRowMatches = (o, vendorId) => !classIsVendor(o.cls) || o.vendor === null || sameVendor(o.vendor, vendorId);
        const vendorMatch = (rows, vendorId) => rows.filter(o => vendorRowMatches(o, vendorId)).sort((a, b) => (b.vendor !== null) - (a.vendor !== null))[0];

        // A Capex % still sitting on the previous class's default follows the class; a hand-entered (or saved) value stays.
        function syncCapex() {
            if (!capex) { return; }
            const defaultFor = c => classOf(c)?.capex ?? 0;
            if (capexClass !== null && capexClass !== cls.value && (capex.value === '' || parseFloat(capex.value) === defaultFor(capexClass))) {
                capex.value = String(defaultFor(cls.value));
            }
            capexClass = cls.value;
        }

        function sync(preferCurrent) {
            const allPriced = pricedFor(phase.value);
            let priced = allPriced;
            const currentPriced = priced.some(o => same(o.type, current.type) && same(o.seniority, current.seniority) && sameText(o.location, current.location) && same(o.cls, current.cls) && vendorRowMatches(o, current.vendor));
            if (preferCurrent && current.type !== '0' && !currentPriced) { priced = []; } // keep a legacy unpriced allocation visible as saved
            const pick = (sel, key) => preferCurrent ? current[key] : sel.value;
            restrict(type, [...new Set(priced.map(o => o.type))], pick(type, 'type'), same);
            const byType = priced.filter(o => same(o.type, type.value));
            restrict(seniority, [...new Set(byType.map(o => o.seniority))], pick(seniority, 'seniority'), same);
            const bySen = byType.filter(o => same(o.seniority, seniority.value));
            restrict(location, [...new Set(bySen.map(o => o.location))], pick(location, 'location'), sameText);
            const byLoc = bySen.filter(o => sameText(o.location, location.value));
            restrict(cls, [...new Set(byLoc.map(o => o.cls))], pick(cls, 'cls'), same);
            const byCls = byLoc.filter(o => same(o.cls, cls.value));
            let match;
            if (vendor) {
                if (isVendor()) {
                    if (vendorWrap) { vendorWrap.hidden = false; }
                    vendor.disabled = false;
                    const anyVendor = byCls.length === 0 || byCls.some(o => o.vendor === null);
                    restrict(vendor, anyVendor ? [] : [...new Set(byCls.map(o => o.vendor))], pick(vendor, 'vendor'), sameVendor);
                    match = vendorMatch(byCls, vendor.value);
                } else {
                    if (vendorWrap) { vendorWrap.hidden = true; }
                    vendor.disabled = true;
                    vendor.value = '';
                    match = byCls[0];
                }
            } else {
                match = byCls[0];
            }
            syncPeople(preferCurrent);
            syncCapex();
            if (match) {
                output.value = money.format(match.rate) + ' /h';
                output.classList.remove('is-invalid');
                output.title = 'Published rate for this combination on ' + phaseStarts[phase.value];
            } else {
                output.value = allPriced.length === 0 ? 'No rate card' : 'No published rate';
                output.classList.add('is-invalid');
                output.title = allPriced.length === 0
                    ? 'No published rate card is effective on ' + phaseStarts[phase.value] + '; any combination can be chosen but will not be costed.'
                    : 'This combination has no published rate.';
            }
        }

        // Offers only roster people whose type / seniority / BU / class (and vendor) match the chosen dimensions; each named person fills one of the Quantity seats.
        function syncPeople(preferCurrent) {
            if (!person) { return; }
            const vendorId = isVendor() && vendor ? vendor.value : '';
            const eligible = people.filter(p => same(p.type, type.value) && same(p.seniority, seniority.value) && (!bu || same(p.bu, bu.value))
                && same(p.cls, cls.value) && (!classIsVendor(p.cls) || sameVendor(p.vendor, vendorId)));
            const wanted = preferCurrent ? current.people : Array.from(person.selectedOptions).map(o => o.value);
            let kept = 0;
            for (const opt of person.options) {
                if (opt.value === '') { continue; }
                const ok = eligible.some(p => same(p.id, opt.value)) || (preferCurrent && current.people.some(id => same(id, opt.value)));
                opt.hidden = !ok;
                opt.disabled = !ok;
                opt.selected = ok && wanted.some(id => same(id, opt.value));
                if (opt.selected) { kept++; }
            }
            if (quantity) {
                const qty = parseInt(quantity.value, 10) || 0;
                if (kept > qty) { quantity.value = String(kept); }
                quantity.min = String(Math.max(1, kept));
                quantity.title = kept > 0 ? kept + ' named ' + (kept === 1 ? 'person fills' : 'people fill') + ' seats; quantity cannot go below that' : '';
            }
            renderPicker();
        }

        // People picker over the (hidden) multi-select: type-to-search list of eligible people with checkboxes, and the chosen ones as chips with an Unassign button.
        const picker = person ? document.createElement('div') : null;
        const search = picker ? document.createElement('input') : null;
        const list = picker ? document.createElement('div') : null;
        const assigned = picker ? document.createElement('div') : null;
        if (picker) {
            person.classList.add('d-none');
            person.setAttribute('aria-hidden', 'true');
            picker.className = 'people-picker';
            search.type = 'search';
            search.className = 'form-control form-control-sm';
            search.placeholder = 'Search people…';
            search.autocomplete = 'off';
            search.setAttribute('aria-label', 'Search people');
            search.addEventListener('input', renderPicker);
            list.className = 'people-picker-list list-group list-group-flush border rounded mt-1 overflow-auto';
            list.style.maxHeight = '9rem';
            list.setAttribute('role', 'group');
            list.setAttribute('aria-label', 'Eligible people');
            assigned.className = 'assigned-people d-flex flex-wrap gap-1 mt-1';
            assigned.setAttribute('aria-live', 'polite');
            picker.append(search, list, assigned);
            person.insertAdjacentElement('afterend', picker);
        }
        function renderPicker() {
            if (!picker) { return; }
            const q = search.value.trim().toLowerCase();
            const eligible = Array.from(person.options).filter(o => o.value !== '' && !o.disabled);
            const shown = eligible.filter(o => q === '' || o.text.toLowerCase().includes(q));
            list.replaceChildren();
            for (const opt of shown) {
                const label = document.createElement('label');
                label.className = 'list-group-item list-group-item-action py-1 px-2 d-flex align-items-center gap-2 small';
                const box = document.createElement('input');
                box.type = 'checkbox';
                box.className = 'form-check-input m-0';
                box.checked = opt.selected;
                box.setAttribute('aria-label', opt.text);
                box.addEventListener('change', () => { opt.selected = box.checked; syncPeople(false); });
                label.append(box, opt.text);
                list.append(label);
            }
            if (shown.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'list-group-item text-muted small py-1 px-2';
                empty.textContent = eligible.length === 0 ? 'No active roster person matches this resource type, seniority, business unit and class' : 'No people match "' + search.value.trim() + '"';
                list.append(empty);
            }
            search.disabled = eligible.length === 0;
            search.placeholder = eligible.length === 0 ? 'No eligible people' : 'Search ' + eligible.length + ' eligible ' + (eligible.length === 1 ? 'person' : 'people') + '…';
            assigned.replaceChildren();
            const selected = Array.from(person.selectedOptions).filter(o => o.value !== '');
            for (const opt of selected) {
                const chip = document.createElement('span');
                chip.className = 'badge rounded-pill text-bg-light border d-inline-flex align-items-center gap-1 fw-normal';
                chip.append(opt.text);
                const x = document.createElement('button');
                x.type = 'button';
                x.className = 'btn-close';
                x.style.fontSize = '0.55em';
                x.title = 'Unassign ' + opt.text;
                x.setAttribute('aria-label', 'Unassign ' + opt.text);
                x.addEventListener('click', () => { opt.selected = false; syncPeople(false); });
                chip.append(x);
                assigned.append(chip);
            }
            if (selected.length > 1) {
                const all = document.createElement('button');
                all.type = 'button';
                all.className = 'btn btn-link btn-sm p-0 align-self-center';
                all.textContent = 'Unassign all';
                all.addEventListener('click', () => { for (const o of person.options) { o.selected = false; } syncPeople(false); });
                assigned.append(all);
            }
        }

        phase.addEventListener('change', () => sync(false));
        type.addEventListener('change', () => sync(false));
        seniority.addEventListener('change', () => sync(false));
        location.addEventListener('change', () => sync(false));
        cls.addEventListener('change', () => sync(false));
        if (vendor) { vendor.addEventListener('change', () => sync(false)); }
        if (bu) { bu.addEventListener('change', () => syncPeople(false)); }
        if (person) { person.addEventListener('change', () => syncPeople(false)); }
        if (quantity && person) { quantity.addEventListener('change', () => syncPeople(false)); }
        sync(true);
    })();
</script>
