@model NonLaborCostEditModel
@{
    var initiative = (Initiative)ViewBag.Initiative;
    var catalog = (IReadOnlyList<CatalogOption>)ViewBag.CatalogOptions;
    var windows = (IReadOnlyDictionary<int, (DateOnly Start, DateOnly End)>)ViewBag.CostPreviewWindows;
    var categories = Html.GetEnumSelectList<CostCategory>().Where(c => c.Value != ((int)CostCategory.Labor).ToString()).ToList();
    ViewData["Title"] = "Edit non-labor cost";
    var panel = SidePanel.IsPanelRequest(Context.Request);
    if (panel) { Layout = SidePanel.Layout; }
    // Ids are prefixed so the panel's form never clashes with the Add form on Details (same "nl-" ids).
    var pfx = panel ? "panel-nl-" : "nl-";
}
@if (!panel)
{
<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="Index">Initiatives</a></li>
    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@initiative.Id">@initiative.Name</a></li>
    <li class="breadcrumb-item active">Edit non-labor cost</li>
</ol></nav>
<h1 class="h3">Edit non-labor cost</h1>
}
<form asp-action="EditNonLaborCost" asp-route-id="@Model.Id" method="post" class="@(panel ? null : "col-lg-8")">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="CostCatalogItemId" for="@(pfx)catalog" class="form-label"></label>
            <select asp-for="CostCatalogItemId" id="@(pfx)catalog" class="form-select">
                <option value="">Ad-hoc</option>
                @foreach (var opt in catalog) { <option value="@opt.Id">@opt.Label</option> }
            </select>
            <span asp-validation-for="CostCatalogItemId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Category" for="@(pfx)category" class="form-label"></label>
            <select asp-for="Category" id="@(pfx)category" asp-items="categories" class="form-select"></select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" for="@(pfx)description" class="form-label"></label>
            <input asp-for="Description" id="@(pfx)description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="PhaseId" for="@(pfx)phase" class="form-label">Scope</label>
            <select asp-for="PhaseId" id="@(pfx)phase" class="form-select">
                <option value="">Whole initiative</option>
                @foreach (var p in initiative.Phases.OrderBy(p => p.Sequence)) { <option value="@p.Id">@p.Name</option> }
            </select>
            <span asp-validation-for="PhaseId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="BillingModel" for="@(pfx)billing" class="form-label"></label>
            <select asp-for="BillingModel" id="@(pfx)billing" asp-items="Html.GetEnumSelectList<BillingModel>()" class="form-select"></select>
            <span asp-validation-for="BillingModel" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Quantity" for="@(pfx)quantity" class="form-label"></label>
            <input asp-for="Quantity" id="@(pfx)quantity" class="form-control" type="number" min="1" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="UnitCost" for="@(pfx)unitcost" class="form-label"></label>
            <input asp-for="UnitCost" id="@(pfx)unitcost" class="form-control" type="number" min="0" step="0.01" />
            <span asp-validation-for="UnitCost" class="text-danger"></span>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label asp-for="StartDate" for="@(pfx)start" class="form-label"></label>
            <input asp-for="StartDate" id="@(pfx)start" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="EndDate" for="@(pfx)end" class="form-label"></label>
            <input asp-for="EndDate" id="@(pfx)end" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
            <div class="form-text">Leave both blank to bill over the phase/initiative window.</div>
        </div>
        <div class="col-md-2">
            <label asp-for="CapexPercent" for="@(pfx)capitalization" class="form-label"></label>
            <input asp-for="CapexPercent" id="@(pfx)capitalization" class="form-control" type="number" min="0" max="100" step="0.01" title="Share of this line's cost that is capitalised; the rest is Opex. Catalog items prefill it." />
            <span asp-validation-for="CapexPercent" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ContractReference" class="form-label"></label>
            <input asp-for="ContractReference" class="form-control" />
            <span asp-validation-for="ContractReference" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="CostCenter" class="form-label"></label>
            <input asp-for="CostCenter" class="form-control" />
            <span asp-validation-for="CostCenter" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label for="@(pfx)preview" class="form-label">Cost preview</label>
            <input id="@(pfx)preview" class="form-control" readonly tabindex="-1" aria-describedby="@(pfx)preview-help" />
            <div class="form-text" id="@(pfx)preview-help">Unit cost × qty × whole periods; final value computed on save.</div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    @if (panel) { <button type="button" class="btn btn-link" data-bs-dismiss="offcanvas">Cancel</button> }
    else { <a asp-action="Details" asp-route-id="@initiative.Id" class="btn btn-link">Cancel</a> }
</form>
@section Scripts {
    @if (!panel) { <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" /> }
    <partial name="_CostPreviewScript" model="@(new CostPreviewScriptModel(pfx, catalog, windows))" />
}
