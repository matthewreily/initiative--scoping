@model InitiativeDetailsModel
@{
    var i = Model.Initiative;
    ViewData["Title"] = i.Name;
    var seniorities = Html.GetEnumSelectList<Seniority>();
    var classes = Html.GetEnumSelectList<ResourcingClass>();
    var roles = Html.GetEnumSelectList<InitiativeMemberRole>();
    var nonLaborCategories = Html.GetEnumSelectList<CostCategory>().Where(c => c.Value != ((int)CostCategory.Labor).ToString()).ToList();
    var billingModels = Html.GetEnumSelectList<BillingModel>();
    var phaseNames = i.Phases.ToDictionary(p => p.Id, p => p.Name);
    var lineByAllocation = Model.Forecast.Lines.ToDictionary(l => l.Allocation.Id);
    var orderedAllocations = i.Allocations
        .OrderBy(a => i.Phases.FirstOrDefault(p => p.Id == a.PhaseId)?.Sequence ?? int.MaxValue)
        .ThenBy(a => Model.ResourceTypeNames.GetValueOrDefault(a.ResourceTypeId))
        .ThenBy(a => a.Seniority).ToList();
    var fixedDuration = i.PlanningMode == PlanningMode.FixedDuration;
    var fd = Model.FixedDuration;
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Initiatives</a></li><li class="breadcrumb-item active">@i.Name</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
    <div>
        <h1 class="h3 mb-1">@i.Name <partial name="_StatusBadge" model="i.Status" /></h1>
        <div class="text-muted small">
            @i.BusinessUnit?.Name
            @if (!string.IsNullOrEmpty(i.SponsoringTeam)) { <span> &middot; @i.SponsoringTeam</span> }
            @if (fixedDuration && i.TargetEnd is not null)
            {
                <span> &middot; Fixed duration @i.TargetStart.ToString("yyyy-MM-dd") → @i.TargetEnd.Value.ToString("yyyy-MM-dd")</span>
            }
            else
            {
                <span> &middot; Target start @i.TargetStart.ToString("yyyy-MM-dd")</span>
            }
            &middot; Sizing: @(i.SizingMethod == SizingMethod.Direct ? "Direct hours" : $"{i.SizingMethod} {i.SizeKey}")
            @if (i.VarianceThresholdPct is not null) { <span> &middot; Variance threshold @i.VarianceThresholdPct%</span> }
        </div>
    </div>
    <div class="d-flex flex-wrap gap-1">
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Lifecycle" asp-action="Baselines" asp-route-id="@i.Id">Baselines (@i.Baselines.Count)</a>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Actuals" asp-action="Initiative" asp-route-id="@i.Id">Actuals</a>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Audit" asp-action="Index" asp-route-entity="Initiative" asp-route-entityId="@i.Id">Audit</a>
        @if (User.IsInRole(InitiativeScoping.Application.AppRoles.Administrator) || User.IsInRole(InitiativeScoping.Application.AppRoles.FinancePmo))
        {
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-controller="Portfolio" asp-action="ExportInitiative" asp-route-id="@i.Id" asp-route-format="xlsx">Excel (.xlsx)</a></li>
                    <li><a class="dropdown-item" asp-controller="Portfolio" asp-action="ExportInitiative" asp-route-id="@i.Id" asp-route-format="csv">CSV</a></li>
                </ul>
            </div>
        }
        @if (Model.CanEdit)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@i.Id">Edit</a>
        }
        @if (Model.CanManage && i.Status == InitiativeStatus.Draft)
        {
            <form asp-action="Delete" asp-route-id="@i.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this initiative and all its scope?');">
                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
            </form>
        }
    </div>
</div>
<partial name="_Alerts" />
@if (!string.IsNullOrEmpty(i.Description))
{
    <p>@i.Description</p>
}
@{
    var open = i.OpenRebaseline;
    var current = i.CurrentBaseline;
}
@if (i.Status == InitiativeStatus.Draft)
{
    <div class="alert @(Model.ActivationBlockers.Count == 0 ? "alert-info" : "alert-warning") py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            @if (Model.ActivationBlockers.Count == 0)
            {
                <text>Ready to activate: the current forecast will be frozen as <strong>baseline v1</strong> and scope will lock.</text>
            }
            else
            {
                <strong>Not ready to activate:</strong> @string.Join(" ", Model.ActivationBlockers)
            }
        </div>
        @if (Model.CanManage)
        {
            <form asp-controller="Lifecycle" asp-action="Activate" asp-route-id="@i.Id" method="post" class="d-flex gap-2 inline-form" onsubmit="return confirm('Activate and capture baseline v1? Scope will be locked.');">
                <input name="reason" aria-label="Note (optional)" class="form-control form-control-sm" placeholder="Note (optional)" style="width: 14rem" />
                <button type="submit" class="btn btn-success btn-sm text-nowrap" disabled="@(Model.ActivationBlockers.Count > 0)">Activate</button>
            </form>
        }
    </div>
}
else
{
    <div class="alert @(Model.ScopeEditable ? "alert-warning" : "alert-secondary") py-2">
        @if (current is not null)
        {
            <div>
                <strong>Baseline v@(current.Version)</strong> (current) &middot; @current.TotalHours.ToString("N1") h &middot; @current.TotalCost.ToString("C0")
                &middot; captured @current.SnapshotAt.ToString("yyyy-MM-dd") by @current.SnapshotBy
                @if (Model.Forecast.TotalCost != current.TotalCost || Model.Forecast.TotalHours != current.TotalHours)
                {
                    var dh = Model.Forecast.TotalHours - current.TotalHours;
                    var dc = Model.Forecast.TotalCost - current.TotalCost;
                    <span class="ms-2 badge @(dc > 0 ? "bg-danger" : "bg-success")" title="Live forecast (current scope at current published rates) vs. current baseline">
                        Live forecast @(dh >= 0 ? "+" : "")@dh.ToString("N1") h / @(dc >= 0 ? "+" : "")@dc.ToString("C0")
                    </span>
                }
            </div>
        }
        @if (open is null)
        {
            <div class="small">Scope is locked while the initiative is @i.Status. @if (i.Status == InitiativeStatus.Active) { <text>Request a re-baseline to change it.</text> }</div>
        }
        else if (open.Status == RebaselineStatus.Pending)
        {
            <div class="small"><strong>Re-baseline requested</strong> by @open.RequestedBy on @open.RequestedAt.ToString("yyyy-MM-dd"): &ldquo;@open.Reason&rdquo; &mdash; awaiting Administrator approval.</div>
        }
        else
        {
            <div class="small"><strong>Re-baseline approved</strong> by @open.DecidedBy &mdash; scope is unlocked. Finalize to capture baseline v@(current?.Version + 1 ?? 1) and lock scope again.</div>
        }
        @if (Model.CanManage || Model.CanApproveRebaseline)
        {
            <div class="d-flex flex-wrap gap-2 mt-2">
                @if (Model.CanManage && i.Status == InitiativeStatus.Active && open is null)
                {
                    <form asp-controller="Lifecycle" asp-action="RequestRebaseline" asp-route-id="@i.Id" method="post" class="d-flex gap-2 inline-form">
                        <input name="reason" aria-label="Reason for re-baseline" class="form-control form-control-sm" placeholder="Reason for re-baseline" style="width: 18rem" required />
                        <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap">Request re-baseline</button>
                    </form>
                }
                @if (Model.CanApproveRebaseline && open?.Status == RebaselineStatus.Pending)
                {
                    <form asp-controller="Lifecycle" asp-action="DecideRebaseline" asp-route-id="@i.Id" method="post" class="d-flex gap-2 inline-form">
                        <input type="hidden" name="requestId" value="@open.Id" />
                        <input name="note" aria-label="Decision note (optional)" class="form-control form-control-sm" placeholder="Decision note (optional)" style="width: 14rem" />
                        <button type="submit" name="approve" value="true" class="btn btn-success btn-sm">Approve</button>
                        <button type="submit" name="approve" value="false" class="btn btn-outline-danger btn-sm">Reject</button>
                    </form>
                }
                @if (Model.CanManage && open?.Status == RebaselineStatus.Approved)
                {
                    <form asp-controller="Lifecycle" asp-action="FinalizeRebaseline" asp-route-id="@i.Id" method="post" onsubmit="return confirm('Capture a new baseline from the current scope and lock it?');">
                        <button type="submit" class="btn btn-success btn-sm" disabled="@(!Model.Forecast.IsComplete)">Finalize baseline v@(current?.Version + 1 ?? 1)</button>
                    </form>
                }
                @if (Model.CanManage && open is not null)
                {
                    <form asp-controller="Lifecycle" asp-action="WithdrawRebaseline" asp-route-id="@i.Id" method="post">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Withdraw request</button>
                    </form>
                }
            </div>
        }
    </div>
}
@if (Model.CanManage && Model.StatusTransitions.Count > 0)
{
    <form asp-controller="Lifecycle" asp-action="ChangeStatus" asp-route-id="@i.Id" method="post" class="d-flex flex-wrap gap-2 align-items-center mb-3 small inline-form" onsubmit="return confirm('Change status to ' + this.to.value + '?');">
        <span class="text-muted">Change status:</span>
        <select name="to" aria-label="New status" class="form-select form-select-sm w-auto">
            @foreach (var s in Model.StatusTransitions) { <option value="@s">@s</option> }
        </select>
        <input name="note" aria-label="Note (optional)" class="form-control form-control-sm" placeholder="Note (optional)" style="width: 14rem" />
        <button type="submit" class="btn btn-outline-secondary btn-sm">Apply</button>
    </form>
}

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Forecast hours</div><div class="fs-3">@Model.Forecast.TotalHours.ToString("N1")</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Forecast cost</div><div class="fs-3">@Model.Forecast.TotalCost.ToString("C0")</div>
        @if (Model.Forecast.NonLaborLines.Count > 0) { <div class="small text-muted" id="forecast-cost-split">Labor @Model.Forecast.LaborCost.ToString("C0") &middot; Non-labor @Model.Forecast.NonLaborCost.ToString("C0")</div> }
        @if (!Model.Forecast.IsComplete) { <span class="badge bg-warning text-dark">Incomplete – unpriced lines</span> }</div></div></div>
    @foreach (var row in Model.ByClass)
    {
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">@row.Label</div><div class="fs-3">@row.Cost.ToString("C0")</div><div class="small text-muted">@row.Hours.ToString("N1") h</div></div></div></div>
    }
    @if (Model.Forecast.NonLaborLines.Count > 0)
    {
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Non-labor</div><div class="fs-3">@Model.Forecast.NonLaborCost.ToString("C0")</div><div class="small text-muted">@Model.Forecast.NonLaborLines.Count line(s)</div></div></div></div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h5">Phases</h2>
        @if (fd is not null)
        {
            <div class="alert alert-info py-2 small mb-3" role="status" id="fixed-duration-summary">
                <strong>Fixed duration:</strong> @fd.Weeks.ToString("0.#") weeks (@fd.CalendarDays calendar days, @fd.WorkingDays working days)
                &middot; @fd.HoursPerDay.ToString("0.##") h/day
                &middot; average staffing @fd.AverageFte.ToString("0.##") FTE
                &middot; phases must tile @fd.Start.ToString("yyyy-MM-dd") → @fd.End.ToString("yyyy-MM-dd") contiguously before activation; allocation hours are computed from staffing %.
            </div>
        }
        @if (Model.Gantt.Count > 0)
        {
            <div class="mb-3 border rounded p-2 bg-light">
                @foreach (var bar in Model.Gantt)
                {
                    <div class="d-flex align-items-center small mb-1">
                        <div class="text-truncate gantt-label" title="@bar.Phase.Name">@bar.Phase.Name</div>
                        <div class="flex-grow-1 position-relative" style="height: 1.25rem">
                            <div class="position-absolute bg-primary rounded text-white text-nowrap overflow-hidden px-1"
                                 style="left: @bar.LeftPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; width: @bar.WidthPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; height: 100%; font-size: .7rem; line-height: 1.25rem"
                                 title="@bar.Phase.PlannedStart.ToString("yyyy-MM-dd") → @bar.Phase.PlannedEnd.ToString("yyyy-MM-dd")">
                                @bar.Phase.PlannedStart.ToString("MMM d") – @bar.Phase.PlannedEnd.ToString("MMM d")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>#</th><th>Phase</th><th>Start</th><th>End</th>@if (fd is not null) { <th class="text-end">Working days</th> }<th class="text-end">Hours</th><th class="text-end">Cost</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in i.Phases.OrderBy(p => p.Sequence))
            {
                var roll = Model.ByPhase.FirstOrDefault(r => r.Label == p.Name);
                <tr>
                    <td>@p.Sequence</td>
                    <td>@p.Name @if (p.DateHistory.Count > 0) { <span class="badge bg-light text-dark border" title="Dates changed @p.DateHistory.Count time(s)">@p.DateHistory.Count</span> }</td>
                    <td>@p.PlannedStart.ToString("yyyy-MM-dd")</td>
                    <td>@p.PlannedEnd.ToString("yyyy-MM-dd")</td>
                    @if (fd is not null) { <td class="text-end">@fd.PhaseWorkingDays.GetValueOrDefault(p.Id)</td> }
                    <td class="text-end">@((roll?.Hours ?? 0).ToString("N1"))</td>
                    <td class="text-end">@((roll?.Cost ?? 0).ToString("C0")) @if (roll?.HasUnpriced == true) { <span class="text-warning" title="Unpriced lines">&#9888;</span> }</td>
                    <td class="text-end text-nowrap">
                        @if (Model.ScopeWritable)
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-action="EditPhase" asp-route-id="@p.Id">Edit</a>
                            <form asp-action="DeletePhase" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Delete phase @p.Name?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (i.Phases.Count == 0)
            {
                <tr><td colspan="8" class="text-muted">No phases yet. Add at least one phase before allocating resources.@if (fixedDuration) { <text> In fixed-duration mode the first phase must start on the target start and phases must end on the target end.</text> }</td></tr>
            }
            </tbody>
        </table>
        </div>
        @if (Model.ScopeWritable)
        {
            <form asp-action="AddPhase" asp-route-id="@i.Id" method="post" class="row g-2 align-items-end mb-4">
                <div class="col-md-5">
                    <label for="name" class="form-label small mb-0">Phase name</label>
                    <input name="Name" id="name" class="form-control form-control-sm" placeholder="e.g. Discovery" required />
                </div>
                <div class="col-md-3">
                    <label for="plannedstart" class="form-label small mb-0">Planned start</label>
                    <input name="PlannedStart" id="plannedstart" type="date" class="form-control form-control-sm" value="@Model.NewPhase.PlannedStart.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-3">
                    <label for="plannedend" class="form-label small mb-0">Planned end</label>
                    <input name="PlannedEnd" id="plannedend" type="date" class="form-control form-control-sm" value="@Model.NewPhase.PlannedEnd.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-1"><button type="submit" class="btn btn-primary btn-sm w-100">Add</button></div>
            </form>
        }

        <h2 class="h5">Allocations</h2>
        <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>Phase</th><th>Resource type</th><th>Seniority</th><th>Location</th><th>Class</th><th class="text-end">Qty</th>@if (fixedDuration) { <th class="text-end">Staffing %</th> }<th class="text-end">Hours</th><th class="text-end">Rate</th><th class="text-end">Cost</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in orderedAllocations)
            {
                var line = lineByAllocation[a.Id];
                <tr class="@(line.IsUnpriced ? "table-warning" : "")">
                    <td>@phaseNames.GetValueOrDefault(a.PhaseId)</td>
                    <td>@Model.ResourceTypeNames.GetValueOrDefault(a.ResourceTypeId)</td>
                    <td>@a.Seniority</td>
                    <td>@a.Location</td>
                    <td>@(a.ResourcingClass == ResourcingClass.InternalFte ? "Internal" : "Vendor")</td>
                    <td class="text-end">@a.Quantity</td>
                    @if (fixedDuration) { <td class="text-end">@(a.AllocationPercent is decimal pct ? pct.ToString("0.##") + "%" : "—")</td> }
                    <td class="text-end">@line.Hours.ToString("N1")</td>
                    <td class="text-end">@(line.HourlyRate is decimal r ? r.ToString("C2") : Html.Raw("<span class='text-danger' title='No exact rate-card match for this resource type / BU / seniority / location / class'>Unpriced</span>"))</td>
                    <td class="text-end">@line.Cost.ToString("C0")</td>
                    <td class="text-end text-nowrap">
                        @if (Model.ScopeWritable)
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-action="EditAllocation" asp-route-id="@a.Id">Edit</a>
                            <form asp-action="DeleteAllocation" asp-route-id="@a.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">&times;</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (i.Allocations.Count == 0)
            {
                <tr><td colspan="11" class="text-muted">No allocations yet.</td></tr>
            }
            </tbody>
            @if (i.Allocations.Count > 0)
            {
                <tfoot class="fw-semibold"><tr><td colspan="@(fixedDuration ? 7 : 6)" class="text-end">Labor total</td><td class="text-end">@Model.Forecast.TotalHours.ToString("N1")</td><td></td><td class="text-end">@Model.Forecast.LaborCost.ToString("C0")</td><td></td></tr></tfoot>
            }
        </table>
        </div>
        @if (Model.ScopeWritable && i.Phases.Count > 0)
        {
            <form asp-action="AddAllocation" asp-route-id="@i.Id" method="post" class="row g-2 align-items-end mb-4">
                <div class="col-md-3">
                    <label for="phaseid" class="form-label small mb-0">Phase</label>
                    <select name="PhaseId" id="phaseid" asp-items="Model.Phases" class="form-select form-select-sm"></select>
                </div>
                <div class="col-md-3">
                    <label for="resourcetypeid" class="form-label small mb-0">Resource type</label>
                    <select name="ResourceTypeId" id="resourcetypeid" asp-items="Model.ResourceTypes" class="form-select form-select-sm"></select>
                </div>
                <div class="col-md-2">
                    <label for="seniority" class="form-label small mb-0">Seniority</label>
                    <select name="Seniority" id="seniority" asp-items="seniorities" class="form-select form-select-sm"></select>
                </div>
                <div class="col-md-2">
                    <label for="location" class="form-label small mb-0">Location</label>
                    <input name="Location" id="location" class="form-control form-control-sm" value="Onshore" required />
                </div>
                <div class="col-md-2">
                    <label for="resourcingclass" class="form-label small mb-0">Class</label>
                    <select name="ResourcingClass" id="resourcingclass" asp-items="classes" class="form-select form-select-sm"></select>
                </div>
                <div class="col-md-2">
                    <label for="quantity" class="form-label small mb-0">Quantity</label>
                    <input name="Quantity" id="quantity" type="number" min="1" class="form-control form-control-sm" value="1" required />
                </div>
                @if (fixedDuration)
                {
                    <div class="col-md-2">
                        <label for="allocationpercent" class="form-label small mb-0">Staffing %</label>
                        <input name="AllocationPercent" id="allocationpercent" type="number" min="0.01" max="100" step="0.01" class="form-control form-control-sm" value="100" required aria-describedby="allocationpercent-help" />
                        <div class="form-text" id="allocationpercent-help">100% = all working hours in the phase.</div>
                    </div>
                    <div class="col-md-2">
                        <label for="computed-hours-new" class="form-label small mb-0">Hours (each)</label>
                        <input id="computed-hours-new" class="form-control form-control-sm" readonly tabindex="-1" aria-describedby="computed-hours-new-help" />
                        <div class="form-text" id="computed-hours-new-help">Computed; final value set on save.</div>
                    </div>
                }
                else
                {
                    <div class="col-md-2">
                        <label for="estimatedhours" class="form-label small mb-0">Hours (each)</label>
                        <input name="EstimatedHours" id="estimatedhours" type="number" min="0.25" step="0.25" class="form-control form-control-sm" required />
                    </div>
                }
                <div class="col-md-3">
                    <label for="contractreference" class="form-label small mb-0">Contract ref</label>
                    <input name="ContractReference" id="contractreference" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label for="costcenter" class="form-label small mb-0">Cost center</label>
                    <input name="CostCenter" id="costcenter" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm w-100">Add</button></div>
            </form>
            @if (fd is not null)
            {
                <partial name="_ComputedHoursScript" model="@(new ComputedHoursScriptModel("phaseid", "allocationpercent", "computed-hours-new", fd.PhaseWorkingDays, fd.HoursPerDay))" />
            }
        }

        <h2 class="h5" id="non-labor-costs">Non-labor costs</h2>
        <p class="text-muted small mb-2">Software licenses and other non-labor spend. Recurring lines bill whole months/years over the phase or initiative window (any partial period counts as a full one) unless explicit dates are set.</p>
        <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>Scope</th><th>Category</th><th>Description</th><th>Billing</th><th class="text-end">Qty</th><th class="text-end">Unit cost</th><th>Window</th><th class="text-end">Periods</th><th class="text-end">Cost</th><th></th></tr></thead>
            <tbody>
            @foreach (var nl in Model.Forecast.NonLaborLines.OrderBy(l => l.Line.PhaseId is null ? int.MaxValue : i.Phases.FirstOrDefault(p => p.Id == l.Line.PhaseId)?.Sequence ?? int.MaxValue).ThenBy(l => l.Line.Description))
            {
                var c = nl.Line;
                <tr class="@(nl.Periods == 0 ? "table-warning" : "")">
                    <td>@(c.PhaseId is null ? "Whole initiative" : phaseNames.GetValueOrDefault(c.PhaseId.Value, "?"))</td>
                    <td>@VarianceCalculator.CategoryLabel(c.Category)</td>
                    <td>@c.Description @if (c.CostCatalogItem is not null) { <span class="badge bg-light text-dark border" title="From catalog">catalog</span> }</td>
                    <td>@Html.DisplayFor(_ => c.BillingModel)</td>
                    <td class="text-end">@c.Quantity</td>
                    <td class="text-end">@c.UnitCost.ToString("C2")</td>
                    <td class="text-nowrap">@(nl.HasWindow ? $"{nl.Start:yyyy-MM-dd} → {nl.End:yyyy-MM-dd}" : "—")</td>
                    <td class="text-end">@(nl.Periods == 0 ? Html.Raw("<span class='text-danger' title='Empty billing window'>0</span>") : nl.Periods)</td>
                    <td class="text-end">@nl.Cost.ToString("C0")</td>
                    <td class="text-end text-nowrap">
                        @if (Model.ScopeWritable)
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-action="EditNonLaborCost" asp-route-id="@c.Id">Edit</a>
                            <form asp-action="DeleteNonLaborCost" asp-route-id="@c.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">&times;</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Forecast.NonLaborLines.Count == 0)
            {
                <tr><td colspan="10" class="text-muted">No non-labor costs yet.</td></tr>
            }
            </tbody>
            @if (Model.Forecast.NonLaborLines.Count > 0)
            {
                <tfoot class="fw-semibold"><tr><td colspan="8" class="text-end">Non-labor total</td><td class="text-end">@Model.Forecast.NonLaborCost.ToString("C0")</td><td></td></tr></tfoot>
            }
        </table>
        </div>
        @if (Model.ScopeWritable)
        {
            <form asp-action="AddNonLaborCost" asp-route-id="@i.Id" method="post" class="row g-2 align-items-end mb-4" id="nl-form">
                <div class="col-md-4">
                    <label for="nl-catalog" class="form-label small mb-0">Catalog item</label>
                    <select name="CostCatalogItemId" id="nl-catalog" class="form-select form-select-sm">
                        <option value="">Ad-hoc (enter details below)</option>
                        @foreach (var opt in Model.CatalogOptions) { <option value="@opt.Id">@opt.Label</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="nl-category" class="form-label small mb-0">Category</label>
                    <select name="Category" id="nl-category" asp-items="nonLaborCategories" class="form-select form-select-sm"></select>
                </div>
                <div class="col-md-5">
                    <label for="nl-description" class="form-label small mb-0">Description</label>
                    <input name="Description" id="nl-description" class="form-control form-control-sm" placeholder="e.g. Jira Software seats" required maxlength="300" />
                </div>
                <div class="col-md-3">
                    <label for="nl-phase" class="form-label small mb-0">Scope</label>
                    <select name="PhaseId" id="nl-phase" class="form-select form-select-sm">
                        <option value="">Whole initiative</option>
                        @foreach (var p in i.Phases.OrderBy(p => p.Sequence)) { <option value="@p.Id">@p.Name</option> }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="nl-billing" class="form-label small mb-0">Billing</label>
                    <select name="BillingModel" id="nl-billing" asp-items="billingModels" class="form-select form-select-sm"></select>
                </div>
                <div class="col-md-1">
                    <label for="nl-quantity" class="form-label small mb-0">Qty</label>
                    <input name="Quantity" id="nl-quantity" type="number" min="1" class="form-control form-control-sm" value="1" required />
                </div>
                <div class="col-md-2">
                    <label for="nl-unitcost" class="form-label small mb-0">Unit cost</label>
                    <input name="UnitCost" id="nl-unitcost" type="number" min="0" step="0.01" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-2">
                    <label for="nl-start" class="form-label small mb-0">Start (optional)</label>
                    <input name="StartDate" id="nl-start" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label for="nl-end" class="form-label small mb-0">End (optional)</label>
                    <input name="EndDate" id="nl-end" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label for="nl-contract" class="form-label small mb-0">Contract ref</label>
                    <input name="ContractReference" id="nl-contract" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label for="nl-costcenter" class="form-label small mb-0">Cost center</label>
                    <input name="CostCenter" id="nl-costcenter" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label for="nl-preview" class="form-label small mb-0">Cost preview</label>
                    <input id="nl-preview" class="form-control form-control-sm" readonly tabindex="-1" aria-describedby="nl-preview-help" />
                    <div class="form-text" id="nl-preview-help">Unit cost × qty × whole periods; final value computed on save.</div>
                </div>
                <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm w-100">Add</button></div>
            </form>
            <partial name="_CostPreviewScript" model="@(new CostPreviewScriptModel("nl-", Model.CatalogOptions, Model.CostPreviewWindows))" />
        }
    </div>

    <div class="col-lg-5">
        <h2 class="h5">Rollup by resource type</h2>
        <div class="table-responsive">
        <table class="table table-sm">
            <thead><tr><th>Resource type</th><th class="text-end">Hours</th><th class="text-end">Cost</th></tr></thead>
            <tbody>
            @foreach (var row in Model.ByResourceType)
            {
                <tr><td>@row.Label</td><td class="text-end">@row.Hours.ToString("N1")</td><td class="text-end">@row.Cost.ToString("C0") @if (row.HasUnpriced) { <span class="text-warning">&#9888;</span> }</td></tr>
            }
            @if (Model.ByResourceType.Count == 0) { <tr><td colspan="3" class="text-muted">Nothing allocated.</td></tr> }
            </tbody>
        </table>
        </div>

        @if (Model.ScopeWritable)
        {
            <h2 class="h5 mt-4">Apply relative size</h2>
            @if (fixedDuration)
            {
                <p class="small text-muted mb-2">Converts a size to target hours (admin conversion table), tiles the fixed window across the template's phases, and sets each allocation's staffing % so it delivers the template hours in its phase.</p>
            }
            else
            {
                <p class="small text-muted mb-2">Converts a size to hours (admin conversion table) and splits them per the matching allocation template, creating any missing phases.</p>
            }
            <form asp-action="ApplySize" asp-route-id="@i.Id" method="post" class="row g-2 align-items-end">
                <div class="col-5">
                    <label for="method" class="form-label small mb-0">Method</label>
                    <select name="Method" id="method" class="form-select form-select-sm">
                        <option value="@SizingMethod.TShirt" selected="@(Model.ApplySize.Method == SizingMethod.TShirt)">T-shirt</option>
                        <option value="@SizingMethod.StoryPoints" selected="@(Model.ApplySize.Method == SizingMethod.StoryPoints)">Story points</option>
                    </select>
                </div>
                <div class="col-3">
                    <label for="sizekey" class="form-label small mb-0">Size</label>
                    <select name="SizeKey" id="sizekey" class="form-select form-select-sm" required>
                        <option value="">Select…</option>
                        @foreach (var o in Model.SizeOptions)
                        {
                            <option value="@o.Key" data-method="@o.Method" selected="@(o.Method == Model.ApplySize.Method && o.Key == Model.ApplySize.SizeKey)">@o.Label</option>
                        }
                    </select>
                </div>
                <div class="col-4">
                    <label for="location-2" class="form-label small mb-0">Location</label>
                    <input name="Location" id="location-2" class="form-control form-control-sm" value="@Model.ApplySize.Location" required />
                </div>
                <div class="col-5">
                    <label for="resourcingclass-2" class="form-label small mb-0">Class</label>
                    <select name="ResourcingClass" id="resourcingclass-2" asp-items="classes" class="form-select form-select-sm"></select>
                </div>
                <div class="col-4 form-check ms-2 mb-1">
                    <input name="Replace" type="checkbox" value="true" class="form-check-input" id="replace" checked />
                    <input name="Replace" type="hidden" value="false" />
                    <label class="form-check-label small" for="replace">Replace existing</label>
                </div>
                <div class="col-2"><button type="submit" class="btn btn-outline-primary btn-sm w-100">Apply</button></div>
            </form>
            <script>
                (function () {
                    const method = document.getElementById('method');
                    const key = document.getElementById('sizekey');
                    function sync() {
                        for (const opt of key.options) {
                            if (!opt.value) continue;
                            const show = opt.dataset.method === method.value;
                            opt.hidden = !show;
                            opt.disabled = !show;
                            if (!show && opt.selected) key.value = '';
                        }
                    }
                    method.addEventListener('change', sync);
                    sync();
                })();
            </script>
        }

        <h2 class="h5 mt-4">Members</h2>
        <div class="table-responsive">
        <table class="table table-sm">
            <thead><tr><th>User</th><th>Role</th><th></th></tr></thead>
            <tbody>
            @foreach (var m in i.Members.OrderBy(m => m.Role).ThenBy(m => m.UserId))
            {
                <tr>
                    <td>@m.UserId</td>
                    <td>@m.Role</td>
                    <td class="text-end">
                        @if (Model.CanManage)
                        {
                            <form asp-action="RemoveMember" asp-route-id="@i.Id" method="post" class="d-inline">
                                <input type="hidden" name="userId" value="@m.UserId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">&times;</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        @if (Model.CanManage)
        {
            <form asp-action="AddMember" asp-route-id="@i.Id" method="post" class="row g-2 align-items-end">
                <div class="col-6">
                    <label for="userid" class="form-label small mb-0">User id</label>
                    <input name="UserId" id="userid" class="form-control form-control-sm" placeholder="user id / object id" required />
                </div>
                <div class="col-4">
                    <label for="role" class="form-label small mb-0">Role</label>
                    <select name="Role" id="role" asp-items="roles" class="form-select form-select-sm"></select>
                </div>
                <div class="col-2"><button type="submit" class="btn btn-outline-primary btn-sm w-100">Add</button></div>
            </form>
        }

        <h2 class="h5 mt-4">Actuals <a class="small fw-normal ms-2" asp-controller="Actuals" asp-action="Initiative" asp-route-id="@i.Id">details</a></h2>
        @{ var v = Model.Variance; }
        <div class="table-responsive">
        <table class="table table-sm">
            <tbody>
            <tr><th>Baseline @(v.Baseline is null ? "" : $"v{v.Baseline.Version}")</th><td class="text-end">@v.BaselineHours.ToString("N1") h</td><td class="text-end">@v.BaselineCost.ToString("C0")</td></tr>
            <tr><th>Actual to date</th><td class="text-end">@v.ActualHours.ToString("N1") h</td><td class="text-end">@v.ActualCost.ToString("C0")</td></tr>
            <tr class="@(v.ExceedsThreshold ? "table-danger" : "")">
                <th>Variance</th>
                <td class="text-end">@((v.HoursVariance >= 0 ? "+" : "") + v.HoursVariance.ToString("N1")) h</td>
                <td class="text-end">@((v.CostVariance >= 0 ? "+" : "") + v.CostVariance.ToString("C0")) @(v.CostVariancePct is null ? "" : $"({(v.CostVariancePct >= 0 ? "+" : "")}{v.CostVariancePct}%)")</td>
            </tr>
            <tr><th>Estimate at completion <span class="text-muted fw-normal small">(actual + ETC @v.EtcCost.ToString("C0"))</span></th><td class="text-end">@v.EacHours.ToString("N1") h</td><td class="text-end">@v.EacCost.ToString("C0")</td></tr>
            <tr class="@(v.EacExceedsThreshold ? "table-danger" : "")">
                <th>Projected variance</th>
                <td class="text-end">@((v.EacHours - v.BaselineHours >= 0 ? "+" : "") + (v.EacHours - v.BaselineHours).ToString("N1")) h</td>
                <td class="text-end">@((v.EacCostVariance >= 0 ? "+" : "") + v.EacCostVariance.ToString("C0")) @(v.EacCostVariancePct is null ? "" : $"({(v.EacCostVariancePct >= 0 ? "+" : "")}{v.EacCostVariancePct}%)")</td>
            </tr>
            </tbody>
        </table>
        </div>
        @if (v.ExceedsThreshold) { <div class="alert alert-danger py-1 small">Cost variance exceeds the @v.ThresholdPct% threshold.</div> }
        @if (v.UnpricedEntries > 0) { <div class="alert alert-warning py-1 small">@v.UnpricedEntries actual entr@(v.UnpricedEntries == 1 ? "y is" : "ies are") unpriced (no matching rate).</div> }
        @if (Model.UnmappedForMappedProjects > 0) { <div class="alert alert-warning py-1 small">@Model.UnmappedForMappedProjects imported entr@(Model.UnmappedForMappedProjects == 1 ? "y" : "ies") for this initiative's projects await person mapping and are excluded above.</div> }

        <h2 class="h5 mt-4">Source mappings</h2>
        <p class="small text-muted">External project identifiers whose actuals belong to this initiative.</p>
        <div class="table-responsive">
        <table class="table table-sm">
            <thead><tr><th>Source</th><th>External project id</th><th></th></tr></thead>
            <tbody>
            @foreach (var m in i.SourceMappings.OrderBy(m => m.Source).ThenBy(m => m.ExternalProjectId))
            {
                <tr>
                    <td>@m.Source</td>
                    <td>@m.ExternalProjectId</td>
                    <td class="text-end">
                        @if (Model.CanManage)
                        {
                            <form asp-action="RemoveSourceMapping" asp-route-id="@i.Id" method="post" class="d-inline">
                                <input type="hidden" name="mappingId" value="@m.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">&times;</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (i.SourceMappings.Count == 0) { <tr><td colspan="3" class="text-muted">No mappings; imported actuals for this initiative will land in the unmapped queue.</td></tr> }
            </tbody>
        </table>
        </div>
        @if (Model.CanManage)
        {
            <form asp-action="AddSourceMapping" asp-route-id="@i.Id" method="post" class="row g-2 align-items-end">
                <div class="col-4">
                    <label for="source" class="form-label small mb-0">Source</label>
                    <select name="source" id="source" class="form-select form-select-sm">
                        @foreach (var s in ActualsSources.All) { <option value="@s">@s</option> }
                    </select>
                </div>
                <div class="col-6">
                    <label for="externalprojectid" class="form-label small mb-0">External project id</label>
                    <input name="externalProjectId" id="externalprojectid" class="form-control form-control-sm" placeholder="e.g. PV-PROJ-100" required maxlength="200" />
                </div>
                <div class="col-2"><button type="submit" class="btn btn-outline-primary btn-sm w-100">Add</button></div>
            </form>
        }
        <p class="small text-muted mt-2">Created by @i.CreatedBy on @i.CreatedAt.ToString("yyyy-MM-dd")</p>
    </div>
</div>
