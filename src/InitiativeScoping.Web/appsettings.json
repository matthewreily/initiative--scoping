{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=initiative_scoping;Username=postgres;Password=CHANGE_ME"
  },
  "Database": {
    "Provider": "PostgreSql",
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Auth": {
    "UseDevelopmentAuth": false
  },
  "Variance": {
    "DefaultThresholdPct": 10
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "AllowedHosts": "*"
}
